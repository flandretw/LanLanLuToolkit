<Page
    x:Class="lanlanlu_toolkit.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:lanlanlu_toolkit.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <ScrollViewer IsScrollInertiaEnabled="True"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <Grid Style="{StaticResource PageScrollableGridStyle}">
            <StackPanel Spacing="24" HorizontalAlignment="Stretch">
                <!-- Page Header: Consistent Fluent Alignment -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                        <TextBlock x:Uid="SettingsPage_Title" Style="{ThemeResource TitleTextBlockStyle}" />
                        <TextBlock x:Uid="SettingsPage_Subtitle" Style="{StaticResource PageHeaderSubtitleStyle}" />
                    </StackPanel>
                </Grid>

                <!-- Appearance & Behavior Section -->
                <StackPanel Spacing="4">
                    <TextBlock x:Uid="SettingsPage_AppearanceBehaviorHeader" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,0,0,8" />
                    
                    <!-- Language Card -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{ThemeResource OverlayCornerRadius}">
                        <Grid MinHeight="64" Padding="16,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xF2B7;" 
                                      FontSize="20" 
                                      Margin="0,0,16,0" 
                                      VerticalAlignment="Center" 
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock x:Uid="SettingsPage_LanguageTitle" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Uid="SettingsPage_LanguageDescription" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox x:Name="LanguageComboBox" 
                                      Grid.Column="2"
                                      Width="200"
                                      VerticalAlignment="Center"
                                      SelectionChanged="LanguageComboBox_SelectionChanged">
                                <ComboBoxItem x:Name="LangZhTwItem" Tag="zh-TW" x:Uid="Language_zh_TW" />
                                <ComboBoxItem x:Name="LangEnUsItem" Tag="en-US" x:Uid="Language_en_US" />
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- Theme Card -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{ThemeResource OverlayCornerRadius}">
                        <Grid MinHeight="64" Padding="16,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE790;" 
                                      FontSize="20" 
                                      Margin="0,0,16,0" 
                                      VerticalAlignment="Center" 
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock x:Uid="SettingsPage_ThemeTitle" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Uid="SettingsPage_ThemeDescription" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox x:Name="ThemeComboBox" 
                                      Grid.Column="2"
                                      Width="200"
                                      VerticalAlignment="Center"
                                      SelectionChanged="ThemeComboBox_SelectionChanged">
                                <ComboBoxItem Tag="Light" x:Uid="Theme_Light" />
                                <ComboBoxItem Tag="Dark" x:Uid="Theme_Dark" />
                                <ComboBoxItem Tag="Default" x:Uid="Theme_Default" />
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- Temperature Unit Card -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{ThemeResource OverlayCornerRadius}">
                        <Grid MinHeight="64" Padding="16,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE9CA;" 
                                      FontSize="20" 
                                      Margin="0,0,16,0" 
                                      VerticalAlignment="Center" 
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock x:Uid="SettingsPage_TempUnitTitle" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Uid="SettingsPage_TempUnitDescription" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox x:Name="TemperatureUnitComboBox" 
                                      Grid.Column="2"
                                      Width="200"
                                      VerticalAlignment="Center"
                                      SelectionChanged="TemperatureUnitComboBox_SelectionChanged">
                                <ComboBoxItem Tag="Celsius" x:Uid="TempUnit_Celsius" />
                                <ComboBoxItem Tag="Fahrenheit" x:Uid="TempUnit_Fahrenheit" />
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- Notifications Card -->
                    <Expander HorizontalAlignment="Stretch" 
                              HorizontalContentAlignment="Stretch"
                              CornerRadius="{ThemeResource OverlayCornerRadius}"
                              MinHeight="64"
                              Padding="0">
                        <Expander.Header>
                            <Grid MinHeight="64" Padding="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xEA8F;" 
                                          FontSize="20" 
                                          Margin="0,0,16,0" 
                                          VerticalAlignment="Center" 
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock x:Uid="SettingsPage_NotificationsTitle" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock x:Uid="SettingsPage_NotificationsDescription" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            VerticalAlignment="Center">
                                    <TextBlock x:Name="NotificationsToggleStateText"
                                               Style="{ThemeResource BodyTextBlockStyle}"
                                               VerticalAlignment="Center"
                                               TextAlignment="Right"
                                               MinWidth="36" />
                                    <ToggleSwitch x:Name="NotificationsToggle" 
                                                  VerticalAlignment="Center"
                                                  Header="{x:Null}"
                                                  MinWidth="0" Padding="0"
                                                  OnContent="" OffContent=""
                                                  Toggled="NotificationsToggle_Toggled" />
                                </StackPanel>
                            </Grid>
                        </Expander.Header>
                        <Expander.Content>
                            <Grid MinHeight="60" Padding="52,10,60,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock x:Uid="SettingsPage_NotificationSound_Title" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock x:Uid="SettingsPage_NotificationSound_Desc" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            VerticalAlignment="Center">
                                    <TextBlock x:Name="NotificationSoundToggleStateText"
                                               Style="{ThemeResource BodyTextBlockStyle}"
                                               VerticalAlignment="Center"
                                               TextAlignment="Right"
                                               MinWidth="36" />
                                    <ToggleSwitch x:Name="NotificationSoundToggle" 
                                                  VerticalAlignment="Center"
                                                  Header="{x:Null}"
                                                  MinWidth="0" Padding="0"
                                                  OnContent="" OffContent=""
                                                  Toggled="NotificationSoundToggle_Toggled" />
                                </StackPanel>
                            </Grid>
                        </Expander.Content>
                    </Expander>
                    
                    <!-- Sound Feedback Card (Global Sound Effects for Interface & Diagnostics) -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{ThemeResource OverlayCornerRadius}">
                        <Grid MinHeight="64" Padding="16,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE767;" 
                                      FontSize="20" 
                                      Margin="0,0,16,0" 
                                      VerticalAlignment="Center" 
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock x:Uid="SettingsPage_SoundEffectsTitle" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Uid="SettingsPage_SoundEffectsDescription" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center">
                                <TextBlock x:Name="SoundEffectsToggleStateText"
                                           Style="{ThemeResource BodyTextBlockStyle}"
                                           VerticalAlignment="Center"
                                           TextAlignment="Right"
                                           MinWidth="36" />
                                <ToggleSwitch x:Name="SoundEffectsToggle" 
                                              VerticalAlignment="Center"
                                              Header="{x:Null}"
                                              MinWidth="0" Padding="0"
                                              OnContent="" OffContent=""
                                              Toggled="SoundEffectsToggle_Toggled" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Diagnostics & Feedback Section -->
                <StackPanel Spacing="4">
                    <TextBlock x:Uid="SettingsPage_DiagnosticsSectionTitle" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,0,0,8" />
                    
                    <!-- Rescan Hardware Specs Card -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{ThemeResource OverlayCornerRadius}">
                        <Grid MinHeight="64" Padding="16,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE72C;" 
                                      FontSize="20" 
                                      Margin="0,0,16,0" 
                                      VerticalAlignment="Center" 
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock x:Uid="SettingsPage_RescanHardware_Title" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Uid="SettingsPage_RescanHardware_Desc" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button x:Name="RescanHardwareButton" 
                                    Grid.Column="2" 
                                    VerticalAlignment="Center"
                                    Click="RescanHardwareButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon x:Name="RescanIcon" Glyph="&#xE72C;" FontSize="14" />
                                    <TextBlock x:Uid="SettingsPage_RescanHardware_ButtonText" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Debug Report Card -->
                    <Expander HorizontalAlignment="Stretch" 
                              HorizontalContentAlignment="Stretch"
                              CornerRadius="{ThemeResource OverlayCornerRadius}"
                              MinHeight="64"
                              Padding="0">
                        <Expander.Header>
                            <Grid MinHeight="64" Padding="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xEBE8;" 
                                          FontSize="20" 
                                          Margin="0,0,16,0" 
                                          VerticalAlignment="Center" 
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock x:Uid="SettingsPage_DebugReportTitle" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock x:Uid="SettingsPage_DebugReportDescription" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            VerticalAlignment="Center">
                                    <TextBlock x:Name="DebugReportToggleStateText"
                                               Style="{ThemeResource BodyTextBlockStyle}"
                                               VerticalAlignment="Center"
                                               TextAlignment="Right"
                                               MinWidth="36" />
                                    <ToggleSwitch x:Name="DebugReportToggle" 
                                                  VerticalAlignment="Center"
                                                  Header="{x:Null}"
                                                  MinWidth="0" Padding="0"
                                                  OnContent="" OffContent=""
                                                  Toggled="DebugReportToggle_Toggled" />
                                </StackPanel>
                            </Grid>
                        </Expander.Header>
                        <Expander.Content>
                            <Grid MinHeight="60" Padding="52,10,60,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock x:Uid="SettingsPage_DebugReport_StorageCardTitle" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock x:Name="DebugReportPathTextBlock" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button x:Name="SelectDebugFolderButton" 
                                            x:Uid="SettingsPage_DebugReport_SelectFolderButton"
                                            Click="SelectDebugFolderButton_Click" />
                                    <Button x:Name="ResetDebugFolderButton" 
                                            x:Uid="SettingsPage_DebugReport_ResetButton"
                                            Style="{ThemeResource AccentButtonStyle}"
                                            Click="ResetDebugFolderButton_Click" />
                                </StackPanel>
                            </Grid>
                        </Expander.Content>
                    </Expander>
                </StackPanel>

                <!-- About Section -->
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="SettingsPage_AboutHeader" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,0,0,4" />
                    <Expander HorizontalAlignment="Stretch" 
                              HorizontalContentAlignment="Stretch" 
                              CornerRadius="{ThemeResource OverlayCornerRadius}"
                              MinHeight="64"
                              Padding="0">
                        <Expander.Header>
                            <Grid MinHeight="64" Padding="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Image x:Name="AppIconImage" Source="ms-appx:///Assets/Square150x150Logo.png" Width="40" Height="40" Margin="0,0,16,0" VerticalAlignment="Center" Stretch="Uniform" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock x:Name="AppNameTextBlock" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="AppCopyrightTextBlock" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Name="AppVersionTextBlock" Grid.Column="2" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource BodyTextBlockStyle}" />
                            </Grid>
                        </Expander.Header>
                        <Expander.Content>
                            <StackPanel MinHeight="48" Padding="56,12,60,12" Spacing="8">
                                <HyperlinkButton x:Uid="SettingsPage_MITLink" NavigateUri="https://github.com/flandretw/LanLanLuToolkit/blob/main/LICENSE.txt" Padding="0" />
                            </StackPanel>
                        </Expander.Content>
                    </Expander>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
