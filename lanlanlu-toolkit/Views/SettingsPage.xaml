<Page
    x:Class="lanlanlu_toolkit.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:lanlanlu_toolkit.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <!-- Small Window State -->
                <VisualState x:Name="SmallState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RootGrid.Padding" Value="12,42,12,24" />
                        <Setter Target="LeftCol.Width" Value="0" />
                        <Setter Target="RightCol.Width" Value="0" />
                        <Setter Target="ContentCol.Width" Value="*" />
                    </VisualState.Setters>
                </VisualState>
                <!-- Wide Window State -->
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1000" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RootGrid.Padding" Value="48,36,48,36" />
                        <Setter Target="LeftCol.Width" Value="*" />
                        <Setter Target="RightCol.Width" Value="*" />
                        <Setter Target="ContentCol.Width" Value="6*" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <ScrollViewer IsScrollInertiaEnabled="True" ManipulationMode="System">
            <Grid x:Name="RootGrid" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="LeftCol" Width="*" />
                    <ColumnDefinition x:Name="ContentCol" Width="6*" />
                    <ColumnDefinition x:Name="RightCol" Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="1" Spacing="28">
                    <TextBlock x:Uid="SettingsPage_Title" Style="{ThemeResource TitleTextBlockStyle}" Margin="0,0,0,12" />

                <!-- Appearance & Behavior Section -->
                <StackPanel Spacing="4">
                    <TextBlock x:Uid="SettingsPage_AppearanceBehaviorHeader" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,0,0,8" />
                    
                    <!-- Language Card -->
                    <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{ThemeResource ControlCornerRadius}">
                        <Grid Padding="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xF2B7;" 
                                      FontSize="20" 
                                      Margin="0,0,16,0" 
                                      VerticalAlignment="Center" 
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock x:Uid="SettingsPage_LanguageTitle" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Uid="SettingsPage_LanguageDescription" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ComboBox x:Name="LanguageComboBox" 
                                      Grid.Column="2"
                                      Width="200"
                                      VerticalAlignment="Center"
                                      SelectionChanged="LanguageComboBox_SelectionChanged">
                                <ComboBoxItem x:Name="LangZhTwItem" Tag="zh-TW" x:Uid="Language_zh_TW" />
                                <ComboBoxItem x:Name="LangEnUsItem" Tag="en-US" x:Uid="Language_en_US" />
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- Theme Card -->
                    <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{ThemeResource ControlCornerRadius}">
                        <Grid Padding="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE790;" 
                                      FontSize="20" 
                                      Margin="0,0,16,0" 
                                      VerticalAlignment="Center" 
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock x:Uid="SettingsPage_ThemeTitle" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Uid="SettingsPage_ThemeDescription" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ComboBox x:Name="ThemeComboBox" 
                                      Grid.Column="2"
                                      Width="200"
                                      VerticalAlignment="Center"
                                      SelectionChanged="ThemeComboBox_SelectionChanged">
                                <ComboBoxItem Tag="Light" x:Uid="Theme_Light" />
                                <ComboBoxItem Tag="Dark" x:Uid="Theme_Dark" />
                                <ComboBoxItem Tag="Default" x:Uid="Theme_Default" />
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- Temperature Unit Card -->
                    <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{ThemeResource ControlCornerRadius}">
                        <Grid Padding="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE9CA;" 
                                      FontSize="20" 
                                      Margin="0,0,16,0" 
                                      VerticalAlignment="Center" 
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock x:Uid="SettingsPage_TempUnitTitle" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Uid="SettingsPage_TempUnitDescription" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ComboBox x:Name="TemperatureUnitComboBox" 
                                      Grid.Column="2"
                                      Width="200"
                                      VerticalAlignment="Center"
                                      SelectionChanged="TemperatureUnitComboBox_SelectionChanged">
                                <ComboBoxItem Tag="Celsius" x:Uid="TempUnit_Celsius" />
                                <ComboBoxItem Tag="Fahrenheit" x:Uid="TempUnit_Fahrenheit" />
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- Notifications Card -->
                    <Expander HorizontalAlignment="Stretch" 
                              HorizontalContentAlignment="Stretch"
                              Padding="0"
                              CornerRadius="{ThemeResource ControlCornerRadius}">
                        <Expander.Header>
                            <Grid HorizontalAlignment="Stretch" MinHeight="72" Padding="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xEA8F;" 
                                          FontSize="20" 
                                          Margin="0,0,16,0" 
                                          VerticalAlignment="Center" 
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock x:Uid="SettingsPage_NotificationsTitle" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock x:Uid="SettingsPage_NotificationsDescription" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="NotificationsToggle" 
                                              Grid.Column="2" 
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Right"
                                              Header="{x:Null}"
                                              MinWidth="0" Margin="0,0,-28,0" Padding="0"
                                              OnContent="" OffContent=""
                                              Toggled="NotificationsToggle_Toggled" />
                            </Grid>
                        </Expander.Header>
                        <Expander.Content>
                            <Grid Padding="52,12,16,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock x:Uid="SettingsPage_NotificationSound_Title" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock x:Uid="SettingsPage_NotificationSound_Desc" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="NotificationSoundToggle" 
                                              Grid.Column="1" 
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Right"
                                              Header="{x:Null}"
                                              MinWidth="0" Margin="0,0,-12,0" Padding="0"
                                              OnContent="" OffContent=""
                                              Toggled="NotificationSoundToggle_Toggled" />
                            </Grid>
                        </Expander.Content>
                    </Expander>
                </StackPanel>

                <!-- Diagnostics & Feedback Section -->
                <StackPanel Spacing="4">
                    <TextBlock x:Uid="SettingsPage_DiagnosticsSectionTitle" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,0,0,8" />
                    
                    <!-- Rescan Hardware Specs Card -->
                    <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{ThemeResource ControlCornerRadius}">
                        <Grid Padding="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE72C;" 
                                      FontSize="20" 
                                      Margin="0,0,16,0" 
                                      VerticalAlignment="Center" 
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock x:Uid="SettingsPage_RescanHardware_Title" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Uid="SettingsPage_RescanHardware_Desc" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Button x:Name="RescanHardwareButton" 
                                    Grid.Column="2" 
                                    VerticalAlignment="Center"
                                    Click="RescanHardwareButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon x:Name="RescanIcon" Glyph="&#xE72C;" FontSize="13" />
                                    <TextBlock x:Uid="SettingsPage_RescanHardware_ButtonText" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Debug Report Card -->
                    <Expander HorizontalAlignment="Stretch" 
                              HorizontalContentAlignment="Stretch"
                              Padding="0"
                              CornerRadius="{ThemeResource ControlCornerRadius}">
                        <Expander.Header>
                            <Grid HorizontalAlignment="Stretch" MinHeight="72" Padding="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xEBE8;" 
                                          FontSize="20" 
                                          Margin="0,0,16,0" 
                                          VerticalAlignment="Center" 
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock x:Uid="SettingsPage_DebugReportTitle" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock x:Uid="SettingsPage_DebugReportDescription" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="DebugReportToggle" 
                                              Grid.Column="2" 
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Right"
                                              Header="{x:Null}"
                                              MinWidth="0" Margin="0,0,-28,0" Padding="0"
                                              OnContent="" OffContent=""
                                              Toggled="DebugReportToggle_Toggled" />
                            </Grid>
                        </Expander.Header>
                        <Expander.Content>
                            <Grid Padding="52,12,16,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock x:Uid="SettingsPage_DebugReport_StorageCardTitle" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock x:Name="DebugReportPathTextBlock" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button x:Name="SelectDebugFolderButton" 
                                            x:Uid="SettingsPage_DebugReport_SelectFolderButton"
                                            Click="SelectDebugFolderButton_Click" />
                                    <Button x:Name="ResetDebugFolderButton" 
                                            x:Uid="SettingsPage_DebugReport_ResetButton"
                                            Style="{ThemeResource AccentButtonStyle}"
                                            Click="ResetDebugFolderButton_Click" />
                                </StackPanel>
                            </Grid>
                        </Expander.Content>
                    </Expander>
                </StackPanel>

                <!-- About Section -->
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="SettingsPage_AboutHeader" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <Expander.Header>
                            <Grid HorizontalAlignment="Stretch" MinHeight="64" Margin="-24,0,0,0" Padding="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Image x:Name="AppIconImage" Source="ms-appx:///Assets/Square150x150Logo.png" Width="64" Height="64" Margin="0,0,-6,0" VerticalAlignment="Center" Stretch="Uniform" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="AppNameTextBlock" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="AppCopyrightTextBlock" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Name="AppVersionTextBlock" Grid.Column="2" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource BodyTextBlockStyle}" Margin="0,0,-18,0" />
                            </Grid>
                        </Expander.Header>
                        <Expander.Content>
                            <HyperlinkButton x:Uid="SettingsPage_MITLink" NavigateUri="https://github.com/flandretw/LanLanLuToolkit/blob/main/LICENSE.txt" Padding="0" />
                        </Expander.Content>
                    </Expander>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
    </Grid>
</Page>
