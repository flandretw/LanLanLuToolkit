<Page
    x:Class="lanlanlu_toolkit.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:lanlanlu_toolkit.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <!-- Small Window State -->
                <VisualState x:Name="SmallState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RootGrid.Padding" Value="12,42,12,24" />
                        <Setter Target="LeftCol.Width" Value="0" />
                        <Setter Target="RightCol.Width" Value="0" />
                        <Setter Target="ContentCol.Width" Value="*" />
                    </VisualState.Setters>
                </VisualState>
                <!-- Wide Window State -->
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1000" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RootGrid.Padding" Value="48,36,48,36" />
                        <Setter Target="LeftCol.Width" Value="*" />
                        <Setter Target="RightCol.Width" Value="*" />
                        <Setter Target="ContentCol.Width" Value="6*" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <ScrollViewer>
            <Grid x:Name="RootGrid" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="LeftCol" Width="*" />
                    <ColumnDefinition x:Name="ContentCol" Width="6*" />
                    <ColumnDefinition x:Name="RightCol" Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="1" Spacing="28">
                    <TextBlock x:Uid="SettingsPage_Title" Style="{ThemeResource TitleTextBlockStyle}" Margin="0,0,0,12" />

                <!-- Appearance & Behavior Section -->
                <StackPanel Spacing="4">
                    <TextBlock x:Uid="SettingsPage_AppearanceBehaviorHeader" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,0,0,8" />
                    
                    <!-- Language Card -->
                    <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{ThemeResource ControlCornerRadius}">
                        <Grid Padding="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xF2B7;" 
                                      FontSize="20" 
                                      Margin="0,0,16,0" 
                                      VerticalAlignment="Center" 
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock x:Uid="SettingsPage_LanguageTitle" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Uid="SettingsPage_LanguageDescription" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ComboBox x:Name="LanguageComboBox" 
                                      Grid.Column="2"
                                      Width="200"
                                      VerticalAlignment="Center"
                                      SelectionChanged="LanguageComboBox_SelectionChanged">
                                <ComboBoxItem x:Name="LangZhTwItem" Tag="zh-TW" x:Uid="Language_zh_TW" />
                                <ComboBoxItem x:Name="LangEnUsItem" Tag="en-US" x:Uid="Language_en_US" />
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- Notification Sound Card -->
                    <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{ThemeResource ControlCornerRadius}">
                        <Grid Padding="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE995;" 
                                      FontSize="20" 
                                      Margin="0,0,16,0" 
                                      VerticalAlignment="Center" 
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock x:Uid="SettingsPage_NotificationSound_Title" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Uid="SettingsPage_NotificationSound_Desc" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="NotificationSoundToggle" 
                                          Grid.Column="2" 
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Right"
                                          Header="{x:Null}"
                                          MinWidth="0" Margin="0,0,-12,0" Padding="0"
                                          OnContent="" OffContent=""
                                          Toggled="NotificationSoundToggle_Toggled" />
                        </Grid>
                    </Border>

                    <!-- Theme Card -->
                    <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{ThemeResource ControlCornerRadius}">
                        <Grid Padding="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE790;" 
                                      FontSize="20" 
                                      Margin="0,0,16,0" 
                                      VerticalAlignment="Center" 
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock x:Uid="SettingsPage_ThemeTitle" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Uid="SettingsPage_ThemeDescription" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ComboBox x:Name="ThemeComboBox" 
                                      Grid.Column="2"
                                      Width="200"
                                      VerticalAlignment="Center"
                                      SelectionChanged="ThemeComboBox_SelectionChanged">
                                <ComboBoxItem Tag="Default" x:Uid="Theme_Default" />
                                <ComboBoxItem Tag="Light" x:Uid="Theme_Light" />
                                <ComboBoxItem Tag="Dark" x:Uid="Theme_Dark" />
                            </ComboBox>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- About Section -->
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="SettingsPage_AboutHeader" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <StackPanel Padding="0,4,0,0" Spacing="8">
                        <TextBlock x:Name="AboutInfoTextBlock" IsTextSelectionEnabled="True" Style="{ThemeResource BodyTextBlockStyle}" />
                        <HyperlinkButton x:Uid="SettingsPage_MITLink" NavigateUri="https://github.com/flandretw/LanLanLuToolkit/blob/main/LICENSE.txt" Padding="0" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
    </Grid>
</Page>
