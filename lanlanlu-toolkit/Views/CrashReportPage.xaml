<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="lanlanlu_toolkit.Views.CrashReportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:lanlanlu_toolkit.Services"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Required"
    Background="Transparent">

    <Page.Resources>
        <!-- Lightweight Windows Update Style Item Template -->
        <DataTemplate x:Key="CrashEventRowTemplate" x:DataType="services:CrashReportItem">
            <Grid BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="0,0,0,1"
                  Padding="28,14,20,14"
                  MinHeight="60">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Summary Row -->
                    <RowDefinition Height="Auto" /> <!-- Expanded Details Panel -->
                </Grid.RowDefinitions>

                <!-- Row 0: Summary Row (Title + Subtitle + 'Learn more' Action) -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Title and Subtitle -->
                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{x:Bind Title}"
                                   Style="{ThemeResource BodyStrongTextBlockStyle}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind FormattedSubtitle}"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!-- Right: '深入了解' Action Button -->
                    <Button Grid.Column="1"
                            Click="ItemLearnMore_Click"
                            Tag="{x:Bind}"
                            Style="{StaticResource SubtleButtonStyle}"
                            VerticalAlignment="Center"
                            Padding="10,6">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind LearnMoreText, Mode=OneWay}"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <FontIcon Glyph="{x:Bind ChevronGlyph, Mode=OneWay}"
                                      FontSize="11"
                                      Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                      VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Row 1: Expanded Details Panel (Rendered only when expanded) -->
                <StackPanel Grid.Row="1"
                            Visibility="{x:Bind ExpandedVisibility, Mode=OneWay}"
                            Spacing="10"
                            Margin="0,12,0,4">

                    <!-- Section: Diagnosis & Recommendation Callout -->
                    <Border Style="{StaticResource FluentCalloutBoxStyle}">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE946;" FontSize="15" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Uid="CrashReportPage_Detail_DiagnosisHeader" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ErrorDescription}" Style="{ThemeResource BodyTextBlockStyle}" LineHeight="20" TextWrapping="Wrap" />

                            <StackPanel Spacing="4" Margin="0,4,0,0">
                                <TextBlock x:Uid="CrashReportPage_Detail_RecommendationHeader" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource AccentFillColorDefaultBrush}" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind Recommendation}" Style="{ThemeResource BodyTextBlockStyle}" LineHeight="20" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Section: Technical Parameters Grid -->
                    <Border Style="{StaticResource FluentWorkspaceBorderStyle}" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="16,12">
                        <Grid RowSpacing="6" ColumnSpacing="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Error Code -->
                            <TextBlock Grid.Row="0" Grid.Column="0" x:Uid="CrashReportPage_Detail_ErrorCode" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ErrorCode}" Style="{ThemeResource BodyStrongTextBlockStyle}" FontFamily="Cascadia Code, Consolas" VerticalAlignment="Center" />

                            <!-- Faulting Module -->
                            <TextBlock Grid.Row="1" Grid.Column="0" x:Uid="CrashReportPage_Detail_FaultModule" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind FaultingModule}" Style="{ThemeResource BodyTextBlockStyle}" FontFamily="Cascadia Code, Consolas" VerticalAlignment="Center" />

                            <!-- Source App -->
                            <TextBlock Grid.Row="2" Grid.Column="0" x:Uid="CrashReportPage_Detail_SourceApp" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind SourceOrApp}" Style="{ThemeResource BodyTextBlockStyle}" VerticalAlignment="Center" />

                            <!-- Dump File / Path -->
                            <TextBlock Grid.Row="3" Grid.Column="0" x:Uid="CrashReportPage_Detail_DumpPath" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind FilePathOrDump}" Style="{ThemeResource BodyTextBlockStyle}" FontFamily="Cascadia Code, Consolas" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Section: Action Toolbar -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="SearchOnline_Click" Tag="{x:Bind}" Style="{StaticResource StandardActionButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE721;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Uid="CrashReportPage_SearchOnline" Style="{ThemeResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Click="LocateDump_Click" Tag="{x:Bind}" Style="{StaticResource StandardActionButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xED25;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Uid="CrashReportPage_Detail_LocateBtn" Style="{ThemeResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Click="CopyReport_Click" Tag="{x:Bind}" Style="{StaticResource StandardActionButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE8C8;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Uid="CrashReportPage_Detail_CopyBtn" Style="{ThemeResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Click="ShowRawLogDialog_Click" Tag="{x:Bind}" Style="{StaticResource StandardActionButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE7BA;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Uid="CrashReportPage_Detail_RawLogHeader" Style="{ThemeResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Style="{StaticResource PageScrollableGridStyle}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- 0: Header & Actions -->
                <RowDefinition Height="Auto" /> <!-- 1: Search Toolbar -->
                <RowDefinition Height="Auto" /> <!-- 2: Status / Loading -->
                <RowDefinition Height="Auto" /> <!-- 3: Expander Category Stream -->
            </Grid.RowDefinitions>

            <!-- 0. Page Header with Action Buttons -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                    <TextBlock x:Uid="CrashReportPage_Title" Style="{ThemeResource TitleTextBlockStyle}" />
                    <TextBlock x:Uid="CrashReportPage_Subtitle" Style="{StaticResource PageHeaderSubtitleStyle}" />
                </StackPanel>

                <!-- Actions -->
                <StackPanel Grid.Column="1" Style="{StaticResource PageHeaderActionsPanelStyle}">
                    <Button x:Name="OpenDumpFolderBtn" Click="OpenDumpFolderBtn_Click" Style="{StaticResource StandardActionButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xED25;" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock x:Uid="CrashReportPage_OpenDumpFolderBtn" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="ExportBtn" Click="ExportBtn_Click" Style="{StaticResource StandardActionButtonStyle}" IsEnabled="False">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xEDE1;" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock x:Uid="CrashReportPage_ExportBtn" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="RefreshBtn" Click="RefreshBtn_Click" Style="{ThemeResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock x:Uid="CrashReportPage_RefreshBtn" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 1. Search Toolbar (Windows 11 Settings Style) -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="CrashSearchBox"
                         x:Uid="CrashReportPage_SearchBox"
                         Width="380"
                         TextChanged="CrashSearchBox_TextChanged"
                         VerticalAlignment="Center" />

                <TextBlock x:Name="ShowingCountText"
                           Grid.Column="1"
                           Margin="16,0,0,0"
                           VerticalAlignment="Center"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>

            <!-- 2. Loading State Panel -->
            <StackPanel x:Name="LoadingPanel"
                        Grid.Row="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12"
                        Margin="0,48,0,48"
                        Visibility="Collapsed">
                <ProgressRing IsActive="True" Width="36" Height="36" />
                <TextBlock x:Uid="CrashReportPage_Scanning" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- 3. Windows Update Style Expander Category Stream -->
            <StackPanel x:Name="CategoriesPanel" Grid.Row="3" Spacing="10">

                <!-- Category 1: Kernel Crashes (BSOD) -->
                <Expander x:Name="BsodExpander"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch"
                          IsExpanded="False"
                          CornerRadius="{ThemeResource OverlayCornerRadius}"
                          Padding="0">
                    <Expander.Header>
                        <Grid HorizontalAlignment="Stretch" MinHeight="68" Padding="8,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Left Icon (Standard 24x24 alignment container) -->
                            <Grid Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,16,0">
                                <FontIcon x:Name="BsodSuccessIcon"
                                          Glyph="&#xE73E;"
                                          FontSize="18"
                                          Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />

                                <FontIcon x:Name="BsodWarningIcon"
                                          Glyph="&#xE7BA;"
                                          FontSize="18"
                                          Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Visibility="Collapsed" />

                                <FontIcon x:Name="BsodNeutralIcon"
                                          Glyph="&#xE721;"
                                          FontSize="18"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Visibility="Collapsed" />
                            </Grid>

                            <!-- Title (with bracket count) + Live Summary Subtitle -->
                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <TextBlock x:Name="BsodExpanderTitle"
                                           Style="{ThemeResource BodyStrongTextBlockStyle}"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="BsodSubtitleText"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Expander.Header>
                    <Expander.Content>
                        <StackPanel>
                            <!-- Healthy State Card (when BSOD Count == 0) -->
                            <Grid x:Name="BsodHealthyPanel" Padding="28,18" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon x:Name="BsodEmptyIcon" Glyph="&#xE73E;" FontSize="20" Foreground="{ThemeResource SystemFillColorSuccessBrush}" VerticalAlignment="Center" Margin="0,0,16,0" />
                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock x:Name="BsodEmptyTitleText" x:Uid="CrashReportPage_Healthy_BSOD_Title" Style="{ThemeResource BodyStrongTextBlockStyle}" FontWeight="SemiBold" />
                                    <TextBlock x:Name="BsodEmptyDescText" x:Uid="CrashReportPage_Healthy_BSOD_Desc" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Grid>

                            <!-- Items List (when BSOD Count > 0) -->
                            <ItemsControl x:Name="BsodItemsControl"
                                          ItemTemplate="{StaticResource CrashEventRowTemplate}" />
                        </StackPanel>
                    </Expander.Content>
                </Expander>

                <!-- Category 2: Application Crashes (Smart expanded) -->
                <Expander x:Name="AppCrashExpander"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch"
                          IsExpanded="True"
                          CornerRadius="{ThemeResource OverlayCornerRadius}"
                          Padding="0">
                    <Expander.Header>
                        <Grid HorizontalAlignment="Stretch" MinHeight="68" Padding="8,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Left Icon (Standard 24x24 alignment container) -->
                            <Grid Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,16,0">
                                <FontIcon x:Name="AppCrashWarningIcon"
                                          Glyph="&#xE783;"
                                          FontSize="18"
                                          Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />

                                <FontIcon x:Name="AppCrashSuccessIcon"
                                          Glyph="&#xE73E;"
                                          FontSize="18"
                                          Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Visibility="Collapsed" />

                                <FontIcon x:Name="AppCrashNeutralIcon"
                                          Glyph="&#xE721;"
                                          FontSize="18"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Visibility="Collapsed" />
                            </Grid>

                            <!-- Title (with bracket count) + Live Summary Subtitle -->
                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <TextBlock x:Name="AppCrashExpanderTitle"
                                           Style="{ThemeResource BodyStrongTextBlockStyle}"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="AppCrashSubtitleText"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Expander.Header>
                    <Expander.Content>
                        <StackPanel>
                            <!-- Healthy State Card (when AppCrash Count == 0) -->
                            <Grid x:Name="AppCrashHealthyPanel" Padding="28,18" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon x:Name="AppCrashEmptyIcon" Glyph="&#xE73E;" FontSize="20" Foreground="{ThemeResource SystemFillColorSuccessBrush}" VerticalAlignment="Center" Margin="0,0,16,0" />
                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock x:Name="AppCrashEmptyTitleText" x:Uid="CrashReportPage_Healthy_AppCrash_Title" Style="{ThemeResource BodyStrongTextBlockStyle}" FontWeight="SemiBold" />
                                    <TextBlock x:Name="AppCrashEmptyDescText" x:Uid="CrashReportPage_Healthy_AppCrash_Desc" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Grid>

                            <!-- Items List -->
                            <ItemsControl x:Name="AppCrashItemsControl"
                                          ItemTemplate="{StaticResource CrashEventRowTemplate}" />

                            <!-- Show More Button (if records > limit) -->
                            <Button x:Name="AppCrashShowMoreBtn"
                                    Click="AppCrashShowMoreBtn_Click"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    HorizontalAlignment="Center"
                                    Margin="0,10,0,10"
                                    Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE70D;" FontSize="12" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                    <TextBlock x:Name="AppCrashShowMoreText"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Expander.Content>
                </Expander>

                <!-- Category 3: Application Hangs (Freezes) -->
                <Expander x:Name="AppHangExpander"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch"
                          IsExpanded="False"
                          CornerRadius="{ThemeResource OverlayCornerRadius}"
                          Padding="0">
                    <Expander.Header>
                        <Grid HorizontalAlignment="Stretch" MinHeight="68" Padding="8,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Left Icon (Standard 24x24 alignment container) -->
                            <Grid Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,16,0">
                                <FontIcon x:Name="AppHangWarningIcon"
                                          Glyph="&#xE823;"
                                          FontSize="18"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />

                                <FontIcon x:Name="AppHangSuccessIcon"
                                          Glyph="&#xE73E;"
                                          FontSize="18"
                                          Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Visibility="Collapsed" />

                                <FontIcon x:Name="AppHangNeutralIcon"
                                          Glyph="&#xE721;"
                                          FontSize="18"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Visibility="Collapsed" />
                            </Grid>

                            <!-- Title (with bracket count) + Live Summary Subtitle -->
                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <TextBlock x:Name="AppHangExpanderTitle"
                                           Style="{ThemeResource BodyStrongTextBlockStyle}"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="AppHangSubtitleText"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Expander.Header>
                    <Expander.Content>
                        <StackPanel>
                            <!-- Healthy State Card (when AppHang Count == 0) -->
                            <Grid x:Name="AppHangHealthyPanel" Padding="20,16" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon x:Name="AppHangEmptyIcon" Glyph="&#xE73E;" FontSize="18" Foreground="{ThemeResource SystemFillColorSuccessBrush}" VerticalAlignment="Center" Margin="0,0,14,0" />
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock x:Name="AppHangEmptyTitleText" x:Uid="CrashReportPage_Healthy_AppHang_Title" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock x:Name="AppHangEmptyDescText" x:Uid="CrashReportPage_Healthy_AppHang_Desc" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Grid>

                            <!-- Items List -->
                            <ItemsControl x:Name="AppHangItemsControl"
                                          ItemTemplate="{StaticResource CrashEventRowTemplate}" />
                        </StackPanel>
                    </Expander.Content>
                </Expander>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
