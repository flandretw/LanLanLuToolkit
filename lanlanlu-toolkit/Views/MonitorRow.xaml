<UserControl
    x:Class="lanlanlu_toolkit.Views.MonitorRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:lanlanlu_toolkit.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Margin="0,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Label and Value on Top Row -->
        <Grid Grid.Row="0" Margin="0,0,0,4">
            <TextBlock x:Name="LabelText" HorizontalAlignment="Left" VerticalAlignment="Center" 
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="ValueText" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Style="{ThemeResource BodyStrongTextBlockStyle}" />
        </Grid>
        
        <!-- Full Width Progress Bar on Bottom Row -->
        <Grid x:Name="BarContainer" Grid.Row="1" Height="12" VerticalAlignment="Center">
            <!-- Background Track -->
            <Border Background="{ThemeResource SystemControlBackgroundBaseLowBrush}" 
                    CornerRadius="6" />
            
            <!-- Fill with Clipping Mask -->
            <Border x:Name="BarFill" 
                    Background="{ThemeResource AccentTextFillColorPrimaryBrush}" 
                    CornerRadius="6"
                    HorizontalAlignment="Stretch">
                <Border.Clip>
                    <RectangleGeometry x:Name="ClipMask" Rect="0,0,2000,12">
                        <RectangleGeometry.Transform>
                            <ScaleTransform x:Name="ClipScale" ScaleX="0" />
                        </RectangleGeometry.Transform>
                    </RectangleGeometry>
                </Border.Clip>
            </Border>
        </Grid>
    </Grid>
</UserControl>
