<Page
    x:Class="lanlanlu_toolkit.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:lanlanlu_toolkit.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="CardHoverOverlayBrush" Color="Black" Opacity="0.06" />
                    <SolidColorBrush x:Key="CardCopyIconBrush" Color="Black" Opacity="0.5" />
                    <AcrylicBrush x:Key="CardAcrylicBrush" 
                                  TintColor="White" 
                                  TintOpacity="0.9" 
                                  FallbackColor="White" />
                </ResourceDictionary>

                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="CardHoverOverlayBrush" Color="White" Opacity="0.08" />
                    <SolidColorBrush x:Key="CardCopyIconBrush" Color="White" Opacity="0.6" />
                    <AcrylicBrush x:Key="CardAcrylicBrush" 
                                  TintColor="Black" 
                                  TintOpacity="0.85" 
                                  FallbackColor="Black" />
                </ResourceDictionary>

                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="CardHoverOverlayBrush" Color="White" Opacity="0.08" />
                    <SolidColorBrush x:Key="CardCopyIconBrush" Color="White" Opacity="0.6" />
                    <AcrylicBrush x:Key="CardAcrylicBrush" 
                                  TintColor="Black" 
                                  TintOpacity="0.85" 
                                  FallbackColor="Black" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="SystemInfoCardButtonStyle" TargetType="HyperlinkButton">
                <Setter Property="Width" Value="220" />
                <Setter Property="Height" Value="120" />
                <Setter Property="Padding" Value="16" />
                <Setter Property="Background" Value="{ThemeResource CardAcrylicBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="HyperlinkButton">
                            <Grid x:Name="RootGrid" 
                                  Background="{TemplateBinding Background}" 
                                  BorderBrush="{TemplateBinding BorderBrush}" 
                                  BorderThickness="{TemplateBinding BorderThickness}" 
                                  CornerRadius="{TemplateBinding CornerRadius}">
                                <ContentPresenter Content="{TemplateBinding Content}" 
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Padding="{TemplateBinding Padding}"
                                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SolidScrollButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Width" Value="20" />
                <Setter Property="Height" Value="40" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <ScrollViewer x:Name="MainScrollViewer" IsScrollInertiaEnabled="True" ManipulationMode="System">
        <Grid x:Name="RootGrid">
            <!-- Background Image Layer -->
            <Grid x:Name="HeroGrid" 
                  VerticalAlignment="Top" 
                  Background="{ThemeResource HeroFadeColor}"
                  Height="{x:Bind HeroHeight, Mode=OneWay}">
                <!-- Rounded Corner Container for Image -->
                <Border CornerRadius="8,0,0,0">
                    <Border.Background>
                        <ImageBrush ImageSource="{ThemeResource HomePageHeroImage}" 
                                    Stretch="UniformToFill" 
                                    AlignmentY="Center"
                                    Opacity="1">
                        </ImageBrush>
                    </Border.Background>
                </Border>

                <!-- Denser Lower Fade Overlay -->
                <Rectangle VerticalAlignment="Bottom" Height="40">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="{ThemeResource HeroFadeColorTransparent}" Offset="0.0" />
                            <GradientStop Color="{ThemeResource HeroFadeColorSemiTransparent}" Offset="0.6" />
                            <GradientStop Color="{ThemeResource HeroFadeColor}" Offset="1.0" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- Top-Left Text Overlay -->
                <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left" Margin="36,32,0,0" Spacing="4">
                    <TextBlock x:Uid="AppTitle" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="Bold" Foreground="{ThemeResource HeroTitleBrush}" />
                    <TextBlock x:Uid="HomePage_PoweredBy" 
                               Style="{ThemeResource BodyTextBlockStyle}" 
                               Foreground="{ThemeResource HeroSubtitleBrush}" />
                </StackPanel>
            </Grid>
            
            <!-- System Information Cards Layer -->
            <Grid VerticalAlignment="Top" 
                  Margin="{x:Bind SystemCardsMargin, Mode=OneWay}"
                  HorizontalAlignment="Stretch">
                
                <ScrollViewer x:Name="CardsScrollViewer" 
                              HorizontalScrollBarVisibility="Hidden" 
                              HorizontalScrollMode="Enabled" 
                              VerticalScrollMode="Disabled"
                              IsScrollInertiaEnabled="True"
                              ManipulationMode="System"
                              ViewChanged="CardsScrollViewer_ViewChanged">
                    <StackPanel Orientation="Horizontal" Spacing="12" Padding="36,4,36,4">
                        
                        <!-- OS Card -->
                        <HyperlinkButton x:Name="OsCard" Style="{StaticResource SystemInfoCardButtonStyle}"
                                         Click="OsCard_Tapped" 
                                         PointerEntered="Card_PointerEntered"
                                         PointerExited="Card_PointerExited"
                                         ToolTipService.ToolTip="{x:Bind OsVersion, Mode=OneWay}">
                            <Grid>
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8A9;" FontSize="16" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                        <TextBlock x:Uid="HomePage_OS" 
                                                   Style="{ThemeResource BodyStrongTextBlockStyle}" 
                                                   FontWeight="Bold"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind OsVersion, Mode=OneWay}" 
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" MaxLines="3" />
                                </StackPanel>
                                <Border x:Name="OsHoverOverlay" Background="{ThemeResource CardHoverOverlayBrush}" Opacity="0" CornerRadius="8" Margin="-16" IsHitTestVisible="False" />
                                <FontIcon x:Name="OsCopyIcon" Glyph="&#xE8C8;" HorizontalAlignment="Right" VerticalAlignment="Bottom" 
                                          FontSize="14" Foreground="{ThemeResource CardCopyIconBrush}" Opacity="0" Margin="0,0,-4,-4" />
                            </Grid>
                        </HyperlinkButton>

                        <!-- CPU Card -->
                        <HyperlinkButton x:Name="CpuCard" Style="{StaticResource SystemInfoCardButtonStyle}"
                                         Click="CpuCard_Tapped" 
                                         PointerEntered="Card_PointerEntered"
                                         PointerExited="Card_PointerExited"
                                         ToolTipService.ToolTip="{x:Bind CpuName, Mode=OneWay}">
                            <Grid>
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xEEA1;" FontSize="16" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                        <TextBlock x:Uid="HomePage_CPU" 
                                                   Style="{ThemeResource BodyStrongTextBlockStyle}" 
                                                   FontWeight="Bold"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind CpuName, Mode=OneWay}" 
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" MaxLines="3" />
                                </StackPanel>
                                <Border x:Name="CpuHoverOverlay" Background="{ThemeResource CardHoverOverlayBrush}" Opacity="0" CornerRadius="8" Margin="-16" IsHitTestVisible="False" />
                                <FontIcon x:Name="CpuCopyIcon" Glyph="&#xE8C8;" HorizontalAlignment="Right" VerticalAlignment="Bottom" 
                                          FontSize="14" Foreground="{ThemeResource CardCopyIconBrush}" Opacity="0" Margin="0,0,-4,-4" />
                            </Grid>
                        </HyperlinkButton>

                        <!-- Motherboard Card -->
                        <HyperlinkButton x:Name="MotherboardCard" Style="{StaticResource SystemInfoCardButtonStyle}"
                                         Click="MotherboardCard_Tapped" 
                                         PointerEntered="Card_PointerEntered"
                                         PointerExited="Card_PointerExited"
                                         ToolTipService.ToolTip="{x:Bind MotherboardModel, Mode=OneWay}">
                            <Grid>
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xEA6C;" FontSize="16" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                        <TextBlock x:Uid="HomePage_Motherboard" 
                                                   Style="{ThemeResource BodyStrongTextBlockStyle}" 
                                                   FontWeight="Bold"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind MotherboardModel, Mode=OneWay}" 
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" MaxLines="3" />
                                </StackPanel>
                                <Border x:Name="MotherboardHoverOverlay" Background="{ThemeResource CardHoverOverlayBrush}" Opacity="0" CornerRadius="8" Margin="-16" IsHitTestVisible="False" />
                                <FontIcon x:Name="MotherboardCopyIcon" Glyph="&#xE8C8;" HorizontalAlignment="Right" VerticalAlignment="Bottom" 
                                          FontSize="14" Foreground="{ThemeResource CardCopyIconBrush}" Opacity="0" Margin="0,0,-4,-4" />
                            </Grid>
                        </HyperlinkButton>

                        <!-- RAM Card -->
                        <HyperlinkButton x:Name="RamCard" Style="{StaticResource SystemInfoCardButtonStyle}"
                                         Click="RamCard_Tapped" 
                                         PointerEntered="Card_PointerEntered"
                                         PointerExited="Card_PointerExited"
                                         ToolTipService.ToolTip="{x:Bind RamSize, Mode=OneWay}">
                            <Grid>
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xEEA0;" FontSize="16" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                        <TextBlock x:Uid="HomePage_RAM" 
                                                   Style="{ThemeResource BodyStrongTextBlockStyle}" 
                                                   FontWeight="Bold"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind RamSize, Mode=OneWay}" 
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <Border x:Name="RamHoverOverlay" Background="{ThemeResource CardHoverOverlayBrush}" Opacity="0" CornerRadius="8" Margin="-16" IsHitTestVisible="False" />
                                <FontIcon x:Name="RamCopyIcon" Glyph="&#xE8C8;" HorizontalAlignment="Right" VerticalAlignment="Bottom" 
                                          FontSize="14" Foreground="{ThemeResource CardCopyIconBrush}" Opacity="0" Margin="0,0,-4,-4" />
                            </Grid>
                        </HyperlinkButton>

                        <!-- GPU Card -->
                        <HyperlinkButton x:Name="GpuCard" Style="{StaticResource SystemInfoCardButtonStyle}"
                                         Click="GpuCard_Tapped" 
                                         PointerEntered="Card_PointerEntered"
                                         PointerExited="Card_PointerExited"
                                         ToolTipService.ToolTip="{x:Bind GpuName, Mode=OneWay}">
                            <Grid>
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xEEA1;" FontSize="16" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                        <TextBlock x:Uid="HomePage_GPU" 
                                                   Style="{ThemeResource BodyStrongTextBlockStyle}" 
                                                   FontWeight="Bold"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind GpuName, Mode=OneWay}" 
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" MaxLines="3" />
                                </StackPanel>
                                <Border x:Name="GpuHoverOverlay" Background="{ThemeResource CardHoverOverlayBrush}" Opacity="0" CornerRadius="8" Margin="-16" IsHitTestVisible="False" />
                                <FontIcon x:Name="GpuCopyIcon" Glyph="&#xE8C8;" HorizontalAlignment="Right" VerticalAlignment="Bottom" 
                                          FontSize="14" Foreground="{ThemeResource CardCopyIconBrush}" Opacity="0" Margin="0,0,-4,-4" />
                            </Grid>
                        </HyperlinkButton>

                        <!-- Storage Card -->
                        <HyperlinkButton x:Name="StorageCard" Style="{StaticResource SystemInfoCardButtonStyle}"
                                         Click="StorageCard_Tapped" 
                                         PointerEntered="Card_PointerEntered"
                                         PointerExited="Card_PointerExited"
                                         ToolTipService.ToolTip="{x:Bind StorageInfo, Mode=OneWay}">
                            <Grid>
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xEDA2;" FontSize="16" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                        <TextBlock x:Uid="HomePage_Storage" 
                                                   Style="{ThemeResource BodyStrongTextBlockStyle}" 
                                                   FontWeight="Bold"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind StorageInfo, Mode=OneWay}" 
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" MaxLines="3" />
                                </StackPanel>
                                <Border x:Name="StorageHoverOverlay" Background="{ThemeResource CardHoverOverlayBrush}" Opacity="0" CornerRadius="8" Margin="-16" IsHitTestVisible="False" />
                                <FontIcon x:Name="StorageCopyIcon" Glyph="&#xE8C8;" HorizontalAlignment="Right" VerticalAlignment="Bottom" 
                                          FontSize="14" Foreground="{ThemeResource CardCopyIconBrush}" Opacity="0" Margin="0,0,-4,-4" />
                            </Grid>
                        </HyperlinkButton>
                    </StackPanel>
                </ScrollViewer>

                <!-- Floating Navigation Buttons -->
                <Button x:Name="ScrollLeftButton" 
                        Style="{StaticResource SolidScrollButtonStyle}"
                        VerticalAlignment="Center" 
                        HorizontalAlignment="Left"
                        Margin="8,0,0,0"
                        Click="ScrollLeft_Click"
                        Opacity="0"
                        IsHitTestVisible="False">
                    <Button.Resources>
                        <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="ControlFillColorSecondaryBrush" />
                        <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="ControlFillColorTertiaryBrush" />
                    </Button.Resources>
                    <FontIcon Glyph="&#xF08D;" FontSize="8" />
                </Button>

                <Button x:Name="ScrollRightButton" 
                        Style="{StaticResource SolidScrollButtonStyle}"
                        VerticalAlignment="Center" 
                        HorizontalAlignment="Right"
                        Margin="0,0,8,0"
                        Click="ScrollRight_Click"
                        Opacity="1"
                        IsHitTestVisible="True">
                    <Button.Resources>
                        <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="ControlFillColorSecondaryBrush" />
                        <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="ControlFillColorTertiaryBrush" />
                    </Button.Resources>
                    <FontIcon Glyph="&#xF08F;" FontSize="8" />
                </Button>
            </Grid>

            <!-- Foreground Content Layer -->
            <StackPanel Spacing="24" MaxWidth="1600" HorizontalAlignment="Stretch" Margin="{x:Bind ContentMargin, Mode=OneWay}">
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                        BorderThickness="1" CornerRadius="8" Padding="32,28">
                    <StackPanel Spacing="16">
                        <TextBlock x:Name="GreetingText" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold" />
                        <TextBlock x:Uid="HomePage_Intro" Style="{ThemeResource BodyTextBlockStyle}" TextWrapping="Wrap" LineHeight="24" />
                        
                        <MenuFlyoutSeparator Margin="0,8" />
                        
                        <StackPanel Orientation="Horizontal" Spacing="64">
                            <StackPanel Spacing="8">
                                <TextBlock x:Uid="HomePage_QuickStart" FontWeight="Bold" />
                                <HyperlinkButton x:Uid="HomePage_ViewPerformance" Click="GoToPerformance_Click" Padding="0" />
                                <HyperlinkButton x:Uid="HomePage_AppSettings" Click="GoToSettings_Click" Padding="0" />
                            </StackPanel>
                            <StackPanel Spacing="8">
                                <TextBlock x:Uid="HomePage_ContactUs" FontWeight="Bold" />
                                <HyperlinkButton x:Uid="HomePage_GitHubProject" NavigateUri="https://github.com/flandretw/LanLanLuToolkit" Padding="0" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
