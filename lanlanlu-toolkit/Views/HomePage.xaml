<Page
    x:Class="lanlanlu_toolkit.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:lanlanlu_toolkit.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <ScrollViewer x:Name="MainScrollViewer">
        <Grid x:Name="RootGrid">
            <!-- Background Image Layer -->
            <Grid x:Name="HeroGrid" 
                  VerticalAlignment="Top" 
                  Height="{x:Bind HeroHeight, Mode=OneWay}">
                <!-- Rounded Corner Container for Image -->
                <Border CornerRadius="8,8,0,0">
                    <Border.Background>
                        <ImageBrush ImageSource="{ThemeResource HomePageHeroImage}" 
                                    Stretch="UniformToFill" 
                                    AlignmentY="Center">
                            <ImageBrush.RelativeTransform>
                                <CompositeTransform TranslateY="0.1" />
                            </ImageBrush.RelativeTransform>
                        </ImageBrush>
                    </Border.Background>
                </Border>

                <!-- Denser Lower Fade Overlay -->
                <Rectangle VerticalAlignment="Bottom" Height="40">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="{ThemeResource HeroFadeColorTransparent}" Offset="0.0" />
                            <GradientStop Color="{ThemeResource HeroFadeColorSemiTransparent}" Offset="0.6" />
                            <GradientStop Color="{ThemeResource HeroFadeColor}" Offset="1.0" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- Top-Left Text Overlay -->
                <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left" Margin="36,32,0,0" Spacing="4">
                    <TextBlock x:Uid="AppTitle" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="Bold" Foreground="{ThemeResource HeroTitleBrush}" />
                    <TextBlock x:Uid="HomePage_PoweredBy" 
                               Style="{ThemeResource BodyTextBlockStyle}" 
                               Foreground="{ThemeResource HeroSubtitleBrush}" />
                </StackPanel>
            </Grid>

            <!-- Foreground Content Layer -->
            <StackPanel Spacing="24" MaxWidth="1600" HorizontalAlignment="Stretch" Margin="{x:Bind ContentMargin, Mode=OneWay}">
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                        BorderThickness="1" CornerRadius="12" Padding="32,28">
                    <StackPanel Spacing="16">
                        <TextBlock x:Name="GreetingText" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold" />
                        <TextBlock x:Uid="HomePage_Intro" Style="{ThemeResource BodyTextBlockStyle}" TextWrapping="Wrap" LineHeight="24" />
                        
                        <MenuFlyoutSeparator Margin="0,8" />
                        
                        <StackPanel Orientation="Horizontal" Spacing="64">
                            <StackPanel Spacing="8">
                                <TextBlock x:Uid="HomePage_QuickStart" FontWeight="Bold" />
                                <HyperlinkButton x:Uid="HomePage_ViewPerformance" Click="GoToPerformance_Click" Padding="0" />
                                <HyperlinkButton x:Uid="HomePage_AppSettings" Click="GoToSettings_Click" Padding="0" />
                            </StackPanel>
                            <StackPanel Spacing="8">
                                <TextBlock x:Uid="HomePage_ContactUs" FontWeight="Bold" />
                                <HyperlinkButton x:Uid="HomePage_GitHubProject" NavigateUri="https://github.com/flandretw/LanLanLuToolkit" Padding="0" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
