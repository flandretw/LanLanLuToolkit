<Page
    x:Class="lanlanlu_toolkit.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:lanlanlu_toolkit.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <ScrollViewer>
        <Grid Padding="36">
            <StackPanel Spacing="24" MaxWidth="1000" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0">
                <!-- Hero Section -->
                <StackPanel Spacing="0" HorizontalAlignment="Center">
                    <Image Source="ms-appx:///Assets/Square44x44Logo.targetsize-256.png" 
                           Width="128" Height="128" 
                           Stretch="Uniform"
                           HorizontalAlignment="Center" />
                    <TextBlock x:Uid="AppTitle" Style="{ThemeResource SubheaderTextBlockStyle}" 
                               HorizontalAlignment="Center" FontWeight="Bold" Margin="0,8,0,0"/>
                    <TextBlock x:Uid="HomePage_PoweredBy" 
                               Style="{ThemeResource BodyTextBlockStyle}" 
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                               HorizontalAlignment="Center" Margin="0,2,0,0" />
                    <TextBlock x:Name="VersionText"
                               Style="{ThemeResource CaptionTextBlockStyle}" 
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" 
                               HorizontalAlignment="Center" />
                </StackPanel>

                <Border Background="{ThemeResource LayerFillColorDefaultBrush}" 
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                        BorderThickness="1" CornerRadius="12" Padding="32">
                    <StackPanel Spacing="16">
                        <TextBlock x:Name="GreetingText" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold" />
                        <TextBlock x:Uid="HomePage_Intro" Style="{ThemeResource BodyTextBlockStyle}" TextWrapping="Wrap" LineHeight="24" />
                        
                        <MenuFlyoutSeparator Margin="0,8" />
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="8">
                                <TextBlock Text="快速開始" FontWeight="Bold" />
                                <HyperlinkButton Content="查看系統效能" Click="GoToPerformance_Click" />
                                <HyperlinkButton Content="軟體設定" Click="GoToSettings_Click" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="8" HorizontalAlignment="Right">
                                <TextBlock Text="聯絡我們" FontWeight="Bold" />
                                <HyperlinkButton Content="GitHub 專案頁面" NavigateUri="https://github.com/flandretw/LanLanLuToolkit" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
