<Page
    x:Class="lanlanlu_toolkit.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:lanlanlu_toolkit.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <!-- Hardware Info Card Button Style -->
        <Style x:Key="HardwareCardButtonStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="20,16" />
            <Setter Property="MinHeight" Value="72" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="RootGrid" 
                              Background="{TemplateBinding Background}" 
                              BorderBrush="{TemplateBinding BorderBrush}" 
                              BorderThickness="{TemplateBinding BorderThickness}" 
                              CornerRadius="{TemplateBinding CornerRadius}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
                                            <Setter Target="RootGrid.BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Background" Value="{ThemeResource ControlFillColorTertiaryBrush}" />
                                            <Setter Target="RootGrid.BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Opacity" Value="0.6" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter Content="{TemplateBinding Content}" 
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Padding="{TemplateBinding Padding}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Feature Action Card Button Style -->
        <Style x:Key="FeatureCardButtonStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="20,16" />
            <Setter Property="MinHeight" Value="72" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="RootGrid" 
                              Background="{TemplateBinding Background}" 
                              BorderBrush="{TemplateBinding BorderBrush}" 
                              BorderThickness="{TemplateBinding BorderThickness}" 
                              CornerRadius="{TemplateBinding CornerRadius}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
                                            <Setter Target="RootGrid.BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Background" Value="{ThemeResource ControlFillColorTertiaryBrush}" />
                                            <Setter Target="RootGrid.BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Opacity" Value="0.6" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter Content="{TemplateBinding Content}" 
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Padding="{TemplateBinding Padding}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <ScrollViewer x:Name="MainScrollViewer" 
                  IsScrollInertiaEnabled="True" 
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <Grid Style="{StaticResource PageScrollableGridStyle}">
            <StackPanel Spacing="20" HorizontalAlignment="Stretch">
                
                <!-- Page Header: Consistent Fluent Alignment -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                        <TextBlock x:Uid="AppTitle" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="Bold" />
                        <TextBlock x:Uid="HomePage_PoweredBy" Style="{StaticResource PageHeaderSubtitleStyle}" />
                    </StackPanel>
                </Grid>

                <!-- Welcome / Greeting Hero Card -->
                <Border Style="{StaticResource FluentCardBorderStyle}" Padding="24,20">
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon x:Name="GreetingIcon" Glyph="&#xE706;" FontSize="36" 
                                  Foreground="{ThemeResource AccentFillColorDefaultBrush}" 
                                  VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <TextBlock x:Name="GreetingText" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold" />
                            <TextBlock x:Uid="HomePage_Intro" Style="{ThemeResource BodyTextBlockStyle}" 
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                       TextWrapping="Wrap" LineHeight="20" />
                        </StackPanel>
                    </Grid>
                </Border>

            <!-- Hardware Specifications Section (3-Column x 2-Row Structured Grid) -->
            <StackPanel Spacing="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               x:Uid="HomePage_HardwareSpecs_Title" 
                               Style="{ThemeResource SubtitleTextBlockStyle}" 
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:Name="RefreshSpecsBtn" 
                                Click="RefreshSpecs_Click" 
                                Style="{StaticResource StandardActionCopyButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon x:Name="RefreshSpecsIcon" Glyph="&#xE72C;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Uid="HomePage_RefreshSpecs" Style="{ThemeResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="CopyAllSpecsBtn" 
                                Click="CopyAllSpecs_Click" 
                                Style="{StaticResource StandardActionCopyButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon x:Name="CopyAllSpecsIcon" Glyph="&#xE8C8;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Uid="HomePage_CopyAllSpecs" Style="{ThemeResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid RowSpacing="12" ColumnSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- OS Card -->
                    <Button x:Name="OsCard" Grid.Row="0" Grid.Column="0" 
                            Style="{StaticResource HardwareCardButtonStyle}"
                            Click="OsCard_Tapped" 
                            PointerEntered="Card_PointerEntered"
                            PointerExited="Card_PointerExited"
                            ToolTipService.ToolTip="{x:Bind OsVersion, Mode=OneWay}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8A9;" FontSize="24" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <TextBlock x:Uid="HomePage_OS" 
                                           Style="{ThemeResource BodyStrongTextBlockStyle}" 
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind OsVersion, Mode=OneWay}" 
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <FontIcon x:Name="OsCopyIcon" Grid.Column="2" Glyph="&#xE8C8;" 
                                      FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                      Opacity="0.4" VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <!-- CPU Card -->
                    <Button x:Name="CpuCard" Grid.Row="0" Grid.Column="1" 
                            Style="{StaticResource HardwareCardButtonStyle}"
                            Click="CpuCard_Tapped" 
                            PointerEntered="Card_PointerEntered"
                            PointerExited="Card_PointerExited"
                            ToolTipService.ToolTip="{x:Bind CpuName, Mode=OneWay}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xEEA1;" FontSize="24" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <TextBlock x:Uid="HomePage_CPU" 
                                           Style="{ThemeResource BodyStrongTextBlockStyle}" 
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind CpuName, Mode=OneWay}" 
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <FontIcon x:Name="CpuCopyIcon" Grid.Column="2" Glyph="&#xE8C8;" 
                                      FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                      Opacity="0.4" VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <!-- Motherboard Card -->
                    <Button x:Name="MotherboardCard" Grid.Row="0" Grid.Column="2" 
                            Style="{StaticResource HardwareCardButtonStyle}"
                            Click="MotherboardCard_Tapped" 
                            PointerEntered="Card_PointerEntered"
                            PointerExited="Card_PointerExited"
                            ToolTipService.ToolTip="{x:Bind MotherboardModel, Mode=OneWay}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xEA6C;" FontSize="24" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <TextBlock x:Uid="HomePage_Motherboard" 
                                           Style="{ThemeResource BodyStrongTextBlockStyle}" 
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind MotherboardModel, Mode=OneWay}" 
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <FontIcon x:Name="MotherboardCopyIcon" Grid.Column="2" Glyph="&#xE8C8;" 
                                      FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                      Opacity="0.4" VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <!-- RAM Card -->
                    <Button x:Name="RamCard" Grid.Row="1" Grid.Column="0" 
                            Style="{StaticResource HardwareCardButtonStyle}"
                            Click="RamCard_Tapped" 
                            PointerEntered="Card_PointerEntered"
                            PointerExited="Card_PointerExited"
                            ToolTipService.ToolTip="{x:Bind RamSize, Mode=OneWay}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xEEA0;" FontSize="24" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <TextBlock x:Uid="HomePage_RAM" 
                                           Style="{ThemeResource BodyStrongTextBlockStyle}" 
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind RamSize, Mode=OneWay}" 
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <FontIcon x:Name="RamCopyIcon" Grid.Column="2" Glyph="&#xE8C8;" 
                                      FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                      Opacity="0.4" VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <!-- GPU Card -->
                    <Button x:Name="GpuCard" Grid.Row="1" Grid.Column="1" 
                            Style="{StaticResource HardwareCardButtonStyle}"
                            Click="GpuCard_Tapped" 
                            PointerEntered="Card_PointerEntered"
                            PointerExited="Card_PointerExited"
                            ToolTipService.ToolTip="{x:Bind GpuName, Mode=OneWay}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xEEA1;" FontSize="24" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <TextBlock x:Uid="HomePage_GPU" 
                                           Style="{ThemeResource BodyStrongTextBlockStyle}" 
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind GpuName, Mode=OneWay}" 
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <FontIcon x:Name="GpuCopyIcon" Grid.Column="2" Glyph="&#xE8C8;" 
                                      FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                      Opacity="0.4" VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <!-- Storage Card -->
                    <Button x:Name="StorageCard" Grid.Row="1" Grid.Column="2" 
                            Style="{StaticResource HardwareCardButtonStyle}"
                            Click="StorageCard_Tapped" 
                            PointerEntered="Card_PointerEntered"
                            PointerExited="Card_PointerExited"
                            ToolTipService.ToolTip="{x:Bind StorageInfo, Mode=OneWay}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xEDA2;" FontSize="24" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <TextBlock x:Uid="HomePage_Storage" 
                                           Style="{ThemeResource BodyStrongTextBlockStyle}" 
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind StorageInfo, Mode=OneWay}" 
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <FontIcon x:Name="StorageCopyIcon" Grid.Column="2" Glyph="&#xE8C8;" 
                                      FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                      Opacity="0.4" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                </Grid>
            </StackPanel>

            <!-- Quick Action Feature Grid Section -->
            <StackPanel Spacing="12">
                <TextBlock x:Uid="HomePage_QuickActions_Title" 
                           Style="{ThemeResource SubtitleTextBlockStyle}" 
                           FontWeight="SemiBold" />

                <!-- Responsive 3-Column Feature Cards Grid -->
                <Grid RowSpacing="12" ColumnSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Feature 1: Input Tester -->
                    <Button Grid.Row="0" Grid.Column="0" 
                            Style="{StaticResource FeatureCardButtonStyle}"
                            Click="FeatureInput_Click">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE765;" FontSize="24" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <TextBlock x:Uid="HomePage_Feature_Input_Title" Style="{ThemeResource BodyStrongTextBlockStyle}" FontWeight="SemiBold" />
                                <TextBlock x:Uid="HomePage_Feature_Input_Desc" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <!-- Feature 2: System Repair -->
                    <Button Grid.Row="0" Grid.Column="1" 
                            Style="{StaticResource FeatureCardButtonStyle}"
                            Click="FeatureRepair_Click">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE762;" FontSize="24" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <TextBlock x:Uid="HomePage_Feature_Repair_Title" Style="{ThemeResource BodyStrongTextBlockStyle}" FontWeight="SemiBold" />
                                <TextBlock x:Uid="HomePage_Feature_Repair_Desc" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <!-- Feature 3: Crash Dump Analysis -->
                    <Button Grid.Row="0" Grid.Column="2" 
                            Style="{StaticResource FeatureCardButtonStyle}"
                            Click="FeatureCrash_Click">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE7BA;" FontSize="24" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <TextBlock x:Uid="HomePage_Feature_Crash_Title" Style="{ThemeResource BodyStrongTextBlockStyle}" FontWeight="SemiBold" />
                                <TextBlock x:Uid="HomePage_Feature_Crash_Desc" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <!-- Feature 4: File Hash Calculator -->
                    <Button Grid.Row="1" Grid.Column="0" 
                            Style="{StaticResource FeatureCardButtonStyle}"
                            Click="FeatureHash_Click">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xEC19;" FontSize="24" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <TextBlock x:Uid="HomePage_Feature_Hash_Title" Style="{ThemeResource BodyStrongTextBlockStyle}" FontWeight="SemiBold" />
                                <TextBlock x:Uid="HomePage_Feature_Hash_Desc" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <!-- Feature 5: File Associations -->
                    <Button Grid.Row="1" Grid.Column="1" 
                            Style="{StaticResource FeatureCardButtonStyle}"
                            Click="FeatureAssoc_Click">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE7AC;" FontSize="24" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <TextBlock x:Uid="HomePage_Feature_Assoc_Title" Style="{ThemeResource BodyStrongTextBlockStyle}" FontWeight="SemiBold" />
                                <TextBlock x:Uid="HomePage_Feature_Assoc_Desc" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                </Grid>
            </StackPanel>

            <!-- Footer Quick Links Bar -->
            <Border Style="{StaticResource FluentCardBorderStyle}">
                <StackPanel Orientation="Horizontal" Spacing="24" VerticalAlignment="Center">
                    <HyperlinkButton Click="GoToSettings_Click" Padding="8,4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE713;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Uid="HomePage_AppSettings" Style="{ThemeResource BodyTextBlockStyle}" VerticalAlignment="Center" />
                        </StackPanel>
                    </HyperlinkButton>

                    <HyperlinkButton NavigateUri="https://github.com/flandretw/LanLanLuToolkit" Padding="8,4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE93C;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Uid="HomePage_GitHubProject" Style="{ThemeResource BodyTextBlockStyle}" VerticalAlignment="Center" />
                        </StackPanel>
                    </HyperlinkButton>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</ScrollViewer>
</Page>
