<Page
    x:Class="lanlanlu_toolkit.Views.FileAssociationPage"
    
    
    
    
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    
    
    
    
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    
    
    
    
    xmlns:local="using:lanlanlu_toolkit.Views"
    
    
    
    
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    
    
    
    
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">
    <ScrollViewer IsScrollInertiaEnabled="True"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <Grid Style="{StaticResource PageScrollableGridStyle}">
            <StackPanel Spacing="20" HorizontalAlignment="Stretch">
                    <!-- Page Header -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                            <TextBlock x:Name="PageHeaderTitleTextBlock" x:Uid="FileAssociationPage_Title" Style="{ThemeResource TitleTextBlockStyle}" />
                            <TextBlock x:Name="PageHeaderDescTextBlock" x:Uid="FileAssociationPage_Desc" Style="{StaticResource PageHeaderSubtitleStyle}" />
                        </StackPanel>
                    </Grid>
                    <!-- Section: Association Configuration -->
                    <StackPanel Spacing="8">
                        <TextBlock x:Uid="FileAssociationPage_ConfigTitle" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,0,0,4" />
                        <!-- Input Card -->
                        <Border Style="{StaticResource FluentCardBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- Left Icon (Standard 24x24 Container for 60px text axis alignment) -->
                                <Grid Width="24" Height="24" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE7B5;" FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <!-- Left input and instruction -->
                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock x:Uid="FileAssociationPage_TargetExtTitle" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock x:Uid="FileAssociationPage_TargetExtDesc" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <!-- Right Textbox -->
                                <TextBox x:Name="ExtensionTextBox" Grid.Column="2" Width="200" x:Uid="FileAssociationPage_TargetExtBox" VerticalAlignment="Center" FontFamily="Cascadia Code, Consolas" TextChanged="ExtensionTextBox_TextChanged" />
                            </Grid>
                        </Border>
                    </StackPanel>
                    <!-- Section: Actions -->
                    <StackPanel Spacing="16">
                        <TextBlock x:Uid="FileAssociationPage_SelectMethodTitle" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,0,0,4" />
                        <!-- Action 1: Reset to default state -->
                        <Border Style="{StaticResource FluentCardBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- Left Icon (Standard 24x24 Container for 60px text axis alignment) -->
                                <Grid Width="24" Height="24" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xEA99;" FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock x:Uid="FileAssociationPage_ResetTitle" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock x:Uid="FileAssociationPage_ResetDesc" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button x:Name="ResetAssociationBtn" Grid.Column="2" Click="ResetAssociationBtn_Click" x:Uid="FileAssociationPage_ResetButton" Style="{ThemeResource AccentButtonStyle}" MinWidth="140" VerticalAlignment="Center" IsEnabled="False" />
                            </Grid>
                        </Border>
                        <!-- Action 2: Advanced Mode -->
                        <Expander x:Name="AdvancedModeExpander"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Stretch"
                                  ExpandDirection="Down"
                                  IsExpanded="False"
                                  CornerRadius="{ThemeResource OverlayCornerRadius}">
                            <Expander.Header>
                                <Grid HorizontalAlignment="Stretch" MinHeight="64" Margin="4,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Standard 24x24 Container (aligned with cards above at 20px left margin) -->
                                    <Grid Width="24" Height="24" Margin="0,0,16,0" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xEC7A;" FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock x:Uid="FileAssociationPage_Method2Title" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                        <TextBlock x:Uid="FileAssociationPage_Method2Desc" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Expander.Header>
                            <Expander.Content>
                                <StackPanel Spacing="16">
                                    <!-- Action Bar inside expander -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Uid="FileAssociationPage_Method2Content" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0" />
                                        <Button x:Name="RegistryNavBtn" Grid.Column="1" Click="RegistryNavBtn_Click" x:Uid="FileAssociationPage_Method2Button" Style="{ThemeResource AccentButtonStyle}" MinWidth="140" VerticalAlignment="Center" IsEnabled="False" />
                                    </Grid>
                                    <!-- Guideline Container inside the expander -->
                                    <Border Style="{StaticResource FluentCalloutBoxStyle}">
                                        <StackPanel Padding="16" Spacing="16">
                                            <TextBlock x:Uid="FileAssociationPage_GuideTitle" Style="{ThemeResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <StackPanel Spacing="12">
                                                <!-- Step 1 -->
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="20" Height="20" CornerRadius="10" Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Center">
                                                        <TextBlock Text="1" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </Border>
                                                    <TextBlock Grid.Column="1" x:Uid="FileAssociationPage_GuideStep1" Style="{ThemeResource CaptionTextBlockStyle}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                </Grid>
                                                <!-- Step 2 -->
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="20" Height="20" CornerRadius="10" Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Center">
                                                        <TextBlock Text="2" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </Border>
                                                    <TextBlock Grid.Column="1" x:Uid="FileAssociationPage_GuideStep2" Style="{ThemeResource CaptionTextBlockStyle}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                </Grid>
                                                <!-- Step 3 -->
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="20" Height="20" CornerRadius="10" Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Center">
                                                        <TextBlock Text="3" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </Border>
                                                    <TextBlock Grid.Column="1" x:Uid="FileAssociationPage_GuideStep3" Style="{ThemeResource CaptionTextBlockStyle}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                </Grid>
                                                <!-- Step 4 -->
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="20" Height="20" CornerRadius="10" Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Center">
                                                        <TextBlock Text="4" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </Border>
                                                    <TextBlock Grid.Column="1" x:Uid="FileAssociationPage_GuideStep4" Style="{ThemeResource CaptionTextBlockStyle}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                </Grid>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Expander.Content>
                        </Expander>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>
</Page>
