<Page
    x:Class="lanlanlu_toolkit.Views.FileAssociationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:lanlanlu_toolkit.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <ScrollViewer IsScrollInertiaEnabled="True" ManipulationMode="System">
            <Grid Padding="36" HorizontalAlignment="Stretch">
                <StackPanel Spacing="24" MaxWidth="1600" HorizontalAlignment="Stretch">
                    
                    <!-- Page Header -->
                    <StackPanel Spacing="4" Margin="0">
                        <TextBlock x:Name="PageHeaderTitleTextBlock" x:Uid="FileAssociationPage_Title" Style="{ThemeResource TitleTextBlockStyle}" />
                        <TextBlock x:Name="PageHeaderDescTextBlock" x:Uid="FileAssociationPage_Desc" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <!-- Section: Association Configuration -->
                    <StackPanel Spacing="8">
                        <TextBlock x:Uid="FileAssociationPage_ConfigTitle" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,0,0,4" />
                        
                        <!-- Input Card -->
                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{ThemeResource OverlayCornerRadius}">
                            <StackPanel Padding="20" Spacing="20">
                                <Grid ColumnSpacing="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Left input and instruction -->
                                    <StackPanel Spacing="4" VerticalAlignment="Center">
                                        <TextBlock x:Uid="FileAssociationPage_TargetExtTitle" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                        <TextBlock x:Uid="FileAssociationPage_TargetExtDesc" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    
                                    <!-- Right Textbox -->
                                    <TextBox x:Name="ExtensionTextBox" Grid.Column="1" Width="200" x:Uid="FileAssociationPage_TargetExtBox" VerticalAlignment="Center" FontFamily="Cascadia Code, Consolas" TextChanged="ExtensionTextBox_TextChanged" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Section: Actions -->
                    <StackPanel Spacing="16">
                        <TextBlock x:Uid="FileAssociationPage_SelectMethodTitle" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,0,0,4" />

                        <!-- Method 1: Safe System Dialog -->
                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{ThemeResource OverlayCornerRadius}">
                            <Grid Padding="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                
                                <FontIcon Glyph="&#xE756;" FontSize="24" Margin="0,0,20,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                
                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center" Margin="0,0,20,0">
                                    <TextBlock x:Uid="FileAssociationPage_Method1Title" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock x:Uid="FileAssociationPage_Method1Desc" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                
                                <Button x:Name="SystemDialogBtn" Grid.Column="2" Click="SystemDialogBtn_Click" x:Uid="FileAssociationPage_Method1Button" Style="{ThemeResource AccentButtonStyle}" Width="160" Height="36" VerticalAlignment="Center" IsEnabled="False" />
                            </Grid>
                        </Border>

                        <!-- Method 2: Advanced Registry Nav using Expander -->
                        <Expander x:Name="AdvancedModeExpander"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Stretch"
                                  ExpandDirection="Down"
                                  IsExpanded="False"
                                  CornerRadius="{ThemeResource OverlayCornerRadius}">
                            <Expander.Header>
                                <Grid ColumnSpacing="20" HorizontalAlignment="Stretch" Margin="4,0,0,0" MinHeight="76">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    
                                    <FontIcon Glyph="&#xEC7A;" FontSize="24" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    
                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock x:Uid="FileAssociationPage_Method2Title" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                        <TextBlock x:Uid="FileAssociationPage_Method2Desc" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Expander.Header>
                            
                            <Expander.Content>
                                <StackPanel Spacing="16">
                                    <TextBlock x:Uid="FileAssociationPage_Method2Content" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    
                                    <Button x:Name="RegistryNavBtn" Click="RegistryNavBtn_Click" x:Uid="FileAssociationPage_Method2Button" Style="{ThemeResource AccentButtonStyle}" Width="160" Height="36" IsEnabled="False" />
                                    
                                    <!-- Guideline Container inside the expander -->
                                    <Border x:Name="RegistryInstructionsCard" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="{ThemeResource ControlCornerRadius}" Visibility="Collapsed" Background="{ThemeResource LayerFillColorDefaultBrush}">
                                        <StackPanel Padding="16" Spacing="12">
                                            <TextBlock x:Uid="FileAssociationPage_GuideTitle" Style="{ThemeResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <StackPanel Spacing="8" Margin="12,0,0,0">
                                                <TextBlock x:Uid="FileAssociationPage_GuideStep1" Style="{ThemeResource CaptionTextBlockStyle}" />
                                                <TextBlock x:Uid="FileAssociationPage_GuideStep2" Style="{ThemeResource CaptionTextBlockStyle}" />
                                                <TextBlock x:Uid="FileAssociationPage_GuideStep3" Style="{ThemeResource CaptionTextBlockStyle}" />
                                                <TextBlock x:Uid="FileAssociationPage_GuideStep4" Style="{ThemeResource CaptionTextBlockStyle}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Expander.Content>
                        </Expander>
                    </StackPanel>

                    <!-- Feedback InfoBar -->
                    <InfoBar x:Name="FeedbackInfoBar" IsOpen="False" IsClosable="True" Severity="Informational" MaxWidth="1600" HorizontalAlignment="Stretch" />

                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
