                                                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="GpuLocationText" Text="--" Style="{ThemeResource BodyStrongTextBlockStyle}" FontSize="13" IsTextSelectionEnabled="True" VerticalAlignment="Center" Margin="8,0,4,0" TextTrimming="CharacterEllipsis" />
                                                <Button Grid.Row="3" Grid.Column="2" Style="{StaticResource SubtleCopyButtonStyle}" Click="CopyButton_Click" Tag="GpuLocationText">
                                                    <FontIcon Glyph="&#xE8C8;" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                </Button>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                </Grid>
                            </StackPanel>

                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</Page>
