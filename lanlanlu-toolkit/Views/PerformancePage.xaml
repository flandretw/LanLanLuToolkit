<Page
    x:Class="lanlanlu_toolkit.Views.PerformancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:lanlanlu_toolkit.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid>
        <ScrollViewer x:Name="ContentScrollViewer" Visibility="Collapsed">
            <Grid x:Name="RootGrid" Padding="36" HorizontalAlignment="Stretch">
                <StackPanel Spacing="16" MaxWidth="1600" HorizontalAlignment="Stretch">
                    <StackPanel.ChildrenTransitions>
                        <TransitionCollection>
                            <EntranceThemeTransition FromVerticalOffset="24" />
                        </TransitionCollection>
                    </StackPanel.ChildrenTransitions>
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock x:Uid="PerformancePage_Title" Style="{ThemeResource TitleTextBlockStyle}" />
                        <TextBlock x:Uid="PerformancePage_Description" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <StackPanel Spacing="16">
                        <!-- CPU Card -->
                        <Border x:Name="CPUCard"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="24"
                                HorizontalAlignment="Stretch">
                            <Grid ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="300" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                
                                <!-- Chart Area (Left) -->
                                <StackPanel Grid.Column="0" Spacing="8">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xEEA1;" FontSize="16" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                            <TextBlock x:Uid="HomePage_CPU" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="Bold" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock x:Name="CpuNameText" x:Uid="HomePage_Detecting" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <Border Height="160" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="0" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                        <Grid x:Name="CpuChartContainer">
                                            <!-- Horizontal Grid Lines -->
                                            <Rectangle Height="1" VerticalAlignment="Top" Margin="0,40,0,0" Fill="{ThemeResource TextFillColorSecondaryBrush}" Opacity="0.2" />
                                            <Rectangle Height="1" VerticalAlignment="Top" Margin="0,80,0,0" Fill="{ThemeResource TextFillColorSecondaryBrush}" Opacity="0.2" />
                                            <Rectangle Height="1" VerticalAlignment="Top" Margin="0,120,0,0" Fill="{ThemeResource TextFillColorSecondaryBrush}" Opacity="0.2" />

                                            <!-- Vertical Grid Lines -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Rectangle Grid.Column="1" Width="1" HorizontalAlignment="Left" Fill="{ThemeResource TextFillColorSecondaryBrush}" Opacity="0.1" />
                                                <Rectangle Grid.Column="2" Width="1" HorizontalAlignment="Left" Fill="{ThemeResource TextFillColorSecondaryBrush}" Opacity="0.1" />
                                                <Rectangle Grid.Column="3" Width="1" HorizontalAlignment="Left" Fill="{ThemeResource TextFillColorSecondaryBrush}" Opacity="0.1" />
                                                <Rectangle Grid.Column="4" Width="1" HorizontalAlignment="Left" Fill="{ThemeResource TextFillColorSecondaryBrush}" Opacity="0.1" />
                                                <Rectangle Grid.Column="5" Width="1" HorizontalAlignment="Left" Fill="{ThemeResource TextFillColorSecondaryBrush}" Opacity="0.1" />
                                            </Grid>

                                            <Polygon x:Name="CpuPolygon" Fill="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.15" VerticalAlignment="Bottom" Points="0,160 300,160" />
                                            <Polyline x:Name="CpuPolyline" Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="2" VerticalAlignment="Bottom" Points="0,160 300,160" />
                                        </Grid>
                                    </Border>
                                    <local:MonitorRow x:Name="CpuUsageRow" x:Uid="HomePage_Usage" ValueSuffix="%" />
                                </StackPanel>

                                <!-- Details Area (Right) -->
                                <StackPanel Grid.Column="1" Spacing="16">
                                    <Grid ColumnSpacing="12" RowSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        
                                        <!-- Row 0: Real-time values -->
                                        <StackPanel Grid.Row="0" Grid.Column="0">
                                            <TextBlock x:Uid="PerfPage_Cpu_CurrentClock" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock x:Name="CpuClockText" Text="-- GHz" FontSize="16" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="1">
                                            <TextBlock x:Uid="PerfPage_Cpu_CurrentTemp" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock x:Name="CpuTempText" Text="-- °C" FontSize="16" FontWeight="SemiBold" />
                                        </StackPanel>

                                        <!-- Row 1: Static Specs -->
                                        <StackPanel Grid.Row="1" Grid.Column="0">
                                            <TextBlock x:Uid="PerfPage_Cpu_BaseSpeed" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock x:Name="CpuBaseSpeedText" Text="--" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1">
                                            <TextBlock x:Uid="PerfPage_Cpu_Sockets" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock x:Name="CpuSocketsText" Text="--" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="2">
                                            <TextBlock x:Uid="PerfPage_Cpu_Cores" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock x:Name="CpuCoresText" Text="--" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="3">
                                            <TextBlock x:Uid="PerfPage_Cpu_Threads" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock x:Name="CpuThreadsText" Text="--" />
                                        </StackPanel>

                                        <!-- Row 2: Caches and Misc -->
                                        <StackPanel Grid.Row="2" Grid.Column="0">
                                            <TextBlock x:Uid="PerfPage_Cpu_Virtualization" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock x:Name="CpuVirtualizationText" Text="--" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="1">
                                            <TextBlock x:Uid="PerfPage_Cpu_L1Cache" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock x:Name="CpuL1Text" Text="--" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="2">
                                            <TextBlock x:Uid="PerfPage_Cpu_L2Cache" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock x:Name="CpuL2Text" Text="--" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="3">
                                            <TextBlock x:Uid="PerfPage_Cpu_L3Cache" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock x:Name="CpuL3Text" Text="--" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- GPUs Container -->
                        <StackPanel x:Name="GpuContainer" Spacing="16" HorizontalAlignment="Stretch">
                            <!-- GpuMonitorCard instances will be added here dynamically -->
                        </StackPanel>

                        <!-- RAM Card -->
                        <Border x:Name="RAMCard"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="24"
                                HorizontalAlignment="Stretch">
                            <Grid ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="300" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Chart Area (Left) -->
                                <StackPanel Grid.Column="0" Spacing="8">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xEEA0;" FontSize="16" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                            <TextBlock x:Uid="HomePage_RAM" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="Bold" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock x:Name="RamNameText" x:Uid="HomePage_Detecting" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <Border Height="160" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="0" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                        <Grid x:Name="RamChartContainer">
                                            <!-- Horizontal Grid Lines -->
                                            <Rectangle Height="1" VerticalAlignment="Top" Margin="0,40,0,0" Fill="{ThemeResource TextFillColorSecondaryBrush}" Opacity="0.2" />
                                            <Rectangle Height="1" VerticalAlignment="Top" Margin="0,80,0,0" Fill="{ThemeResource TextFillColorSecondaryBrush}" Opacity="0.2" />
                                            <Rectangle Height="1" VerticalAlignment="Top" Margin="0,120,0,0" Fill="{ThemeResource TextFillColorSecondaryBrush}" Opacity="0.2" />

                                            <!-- Vertical Grid Lines -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Rectangle Grid.Column="1" Width="1" HorizontalAlignment="Left" Fill="{ThemeResource TextFillColorSecondaryBrush}" Opacity="0.1" />
                                                <Rectangle Grid.Column="2" Width="1" HorizontalAlignment="Left" Fill="{ThemeResource TextFillColorSecondaryBrush}" Opacity="0.1" />
                                                <Rectangle Grid.Column="3" Width="1" HorizontalAlignment="Left" Fill="{ThemeResource TextFillColorSecondaryBrush}" Opacity="0.1" />
                                                <Rectangle Grid.Column="4" Width="1" HorizontalAlignment="Left" Fill="{ThemeResource TextFillColorSecondaryBrush}" Opacity="0.1" />
                                                <Rectangle Grid.Column="5" Width="1" HorizontalAlignment="Left" Fill="{ThemeResource TextFillColorSecondaryBrush}" Opacity="0.1" />
                                            </Grid>

                                            <Polygon x:Name="RamPolygon" Fill="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.15" VerticalAlignment="Bottom" Points="0,160 300,160" />
                                            <Polyline x:Name="RamPolyline" Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="2" VerticalAlignment="Bottom" Points="0,160 300,160" />
                                        </Grid>
                                    </Border>
                                    <local:MonitorRow x:Name="RamUsageRow" x:Uid="HomePage_Usage" ValueSuffix="%" />
                                </StackPanel>
                                <!-- Details Area (Right) -->
                                <StackPanel Grid.Column="1" Spacing="16">
                                    <Grid ColumnSpacing="12" RowSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        
                                        <!-- Row 0: Capacity & Usage -->
                                        <StackPanel Grid.Row="0" Grid.Column="0">
                                            <TextBlock x:Uid="PerfPage_Ram_InUse" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock x:Name="RamInUseText" Text="-- GB" FontSize="16" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="1">
                                            <TextBlock x:Uid="PerfPage_Ram_Available" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock x:Name="RamAvailableText" Text="-- GB" FontSize="16" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="2">
                                            <TextBlock x:Uid="PerfPage_Ram_Committed" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock x:Name="RamCommittedText" Text="-- / --" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="3">
                                            <TextBlock x:Uid="PerfPage_Ram_Cached" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock x:Name="RamCachedText" Text="-- GB" />
                                        </StackPanel>

                                        <!-- Row 1: Pools & Compressed -->
                                        <StackPanel Grid.Row="1" Grid.Column="0">
                                            <TextBlock x:Uid="PerfPage_Ram_PagedPool" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock x:Name="RamPagedPoolText" Text="-- MB" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1">
                                            <TextBlock x:Uid="PerfPage_Ram_NonPagedPool" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock x:Name="RamNonPagedPoolText" Text="-- MB" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="2">
                                            <TextBlock x:Uid="PerfPage_Ram_Compressed" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock x:Name="RamCompressedText" Text="-- MB" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="3">
                                            <TextBlock x:Uid="PerfPage_Ram_HardwareReserved" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock x:Name="RamHardwareReservedText" Text="-- MB" />
                                        </StackPanel>

                                        <!-- Row 2: Specs & Hardware -->
                                        <StackPanel Grid.Row="2" Grid.Column="0">
                                            <TextBlock x:Uid="PerfPage_Ram_Speed" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock x:Name="RamSpeedText" Text="-- MT/s" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="1">
                                            <TextBlock x:Uid="PerfPage_Ram_Slots" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock x:Name="RamSlotsText" Text="-- / --" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="2">
                                            <TextBlock x:Uid="PerfPage_Ram_FormFactor" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock x:Name="RamFormFactorText" Text="--" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Loading Overlay -->
        <StackPanel x:Name="LoadingOverlay" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
            <ProgressRing IsActive="True" Width="48" Height="48" />
            <TextBlock x:Uid="PerformancePage_Loading" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </Grid>
</Page>
