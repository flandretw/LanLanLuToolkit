                                                <TextBlock Grid.Row="0" Grid.Column="0" x:Uid="PerformancePage_Ram_PagedPool" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
