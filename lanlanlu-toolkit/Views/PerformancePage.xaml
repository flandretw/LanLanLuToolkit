<Page
    x:Class="lanlanlu_toolkit.Views.PerformancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:lanlanlu_toolkit.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Required"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <!-- Subtle Compact Copy Button Style -->
        <Style x:Key="SubtleCopyButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="MinWidth" Value="24" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        
        <!-- Header Copy All Button Style -->
        <Style x:Key="HeaderCopyButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- Nav Card Item Styles (100% Dynamic ThemeResource Engine for All Items) -->
        <Style x:Key="NavCardBackgroundStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="NavPillStyle" TargetType="Border">
            <Setter Property="Width" Value="3" />
            <Setter Property="Height" Value="24" />
            <Setter Property="CornerRadius" Value="1.5" />
            <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
        </Style>
        <Style x:Key="NavIconStyle" TargetType="FontIcon">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style x:Key="NavUsageTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style x:Key="NavSubtextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="NavPolygonStyle" TargetType="Polygon">
            <Setter Property="Fill" Value="{ThemeResource AccentFillColorDefaultBrush}" />
            <Setter Property="Opacity" Value="0.15" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="NavPolylineStyle" TargetType="Polyline">
            <Setter Property="Stroke" Value="{ThemeResource AccentFillColorDefaultBrush}" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
    </Page.Resources>

    <Grid Padding="36" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- 0: Page Header -->
            <RowDefinition Height="*" />    <!-- 1: Master-Detail Content Area -->
        </Grid.RowDefinitions>

        <!-- Page Header -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock x:Uid="PerformancePage_Title" Style="{ThemeResource TitleTextBlockStyle}" />
            <TextBlock x:Uid="PerformancePage_Description" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- Master-Detail Content Area -->
        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="240" MaxWidth="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: Master Hardware Navigation Panel (Same as CrashReportPage) -->
            <Border Grid.Column="0"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource OverlayCornerRadius}"
                    Padding="6">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="MasterCardList" Spacing="4">
                        
                        <!-- 1. CPU Navigation Item -->
                        <Grid Tag="CPU"
                              PointerPressed="NavCard_PointerPressed"
                              PointerEntered="NavCard_PointerEntered"
                              PointerExited="NavCard_PointerExited"
                              Background="Transparent">
                            
                            <!-- Item Background Card (ThemeResource with Opacity control matching CrashReportPage) -->
                            <Border x:Name="CpuNavCardBg"
                                    CornerRadius="{ThemeResource ControlCornerRadius}"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    Opacity="1.0" />
                            
                            <!-- Left Selection Indicator Pill (ThemeResource) -->
                            <Border x:Name="CpuNavPill"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Width="3"
                                    Height="24"
                                    CornerRadius="1.5"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    Opacity="1.0" />
                            
                            <!-- Content -->
                            <Grid Margin="11,10,8,10" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                
                                <FontIcon Glyph="&#xEEA1;" FontSize="22" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <Grid>
                                        <TextBlock Text="CPU" Style="{ThemeResource BodyStrongTextBlockStyle}" FontWeight="SemiBold" FontSize="14" />
                                        <TextBlock x:Name="CpuNavUsageText" Text="0%" HorizontalAlignment="Right" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                    <TextBlock x:Name="CpuNavSubtext" Text="--" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                                    
                                    <!-- Clean Mini Waveform -->
                                    <Grid x:Name="CpuNavChartContainer" Height="28" Margin="0,2,0,0">
                                        <Polygon x:Name="CpuNavPolygon" Fill="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.15" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                        <Polyline x:Name="CpuNavPolyline" Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="1.5" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- 2. RAM Navigation Item -->
                        <Grid Tag="RAM"
                              PointerPressed="NavCard_PointerPressed"
                              PointerEntered="NavCard_PointerEntered"
                              PointerExited="NavCard_PointerExited"
                              Background="Transparent">
                            
                            <!-- Item Background Card (ThemeResource) -->
                            <Border x:Name="RamNavCardBg"
                                    CornerRadius="{ThemeResource ControlCornerRadius}"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    Opacity="0" />
                            
                            <!-- Left Selection Indicator Pill (ThemeResource) -->
                            <Border x:Name="RamNavPill"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Width="3"
                                    Height="24"
                                    CornerRadius="1.5"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    Opacity="0" />
                            
                            <!-- Content -->
                            <Grid Margin="11,10,8,10" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                
                                <FontIcon Glyph="&#xEEA0;" FontSize="22" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <Grid>
                                        <TextBlock x:Uid="PerformancePage_Memory_Title" Style="{ThemeResource BodyStrongTextBlockStyle}" FontWeight="SemiBold" FontSize="14" />
                                        <TextBlock x:Name="RamNavUsageText" Text="0%" HorizontalAlignment="Right" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                    <TextBlock x:Name="RamNavSubtext" Text="--" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                                    
                                    <!-- Clean Mini Waveform -->
                                    <Grid x:Name="RamNavChartContainer" Height="28" Margin="0,2,0,0">
                                        <Polygon x:Name="RamNavPolygon" Fill="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.15" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                        <Polyline x:Name="RamNavPolyline" Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="1.5" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- 3. Storage / Disk Dynamic Navigation Items Container -->
                        <StackPanel x:Name="DiskNavCardContainer" Spacing="4" />

                        <!-- 4. GPU Dynamic Navigation Items Container -->
                        <StackPanel x:Name="GpuNavCardContainer" Spacing="4" />

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Right: Detailed Dashboard Area -->
            <Border Grid.Column="1"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource OverlayCornerRadius}">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
                        <Grid>
                            
                            <!-- 1. CPU Detail Dashboard Panel -->
                            <StackPanel x:Name="CpuDetailPanel" Spacing="16" Visibility="Visible">
                                
                                <!-- Header Info -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Spacing="4" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xEEA1;" FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="CPU" Style="{ThemeResource TitleTextBlockStyle}" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" />
                                            
                                            <!-- Copy All Info Button -->
                                            <Button x:Name="CopyAllCpuBtn"
                                                    Click="CopyAllCpu_Click"
                                                    Style="{StaticResource HeaderCopyButtonStyle}"
                                                    Margin="8,0,0,0">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE8C8;" FontSize="12" />
                                                    <TextBlock x:Uid="PerformancePage_CopyAll" Style="{ThemeResource BodyTextBlockStyle}" FontSize="12" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                        
                                        <!-- CPU Model + Direct Copy Button -->
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock x:Name="CpuNameText" Text="--"
                                                       IsTextSelectionEnabled="True"
                                                       Style="{ThemeResource BodyTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextWrapping="Wrap" />
                                            <Button Style="{StaticResource SubtleCopyButtonStyle}" Click="CopyButton_Click" Tag="CpuNameText">
                                                <FontIcon Glyph="&#xE8C8;" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Big Real-time Stats -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="24" VerticalAlignment="Center">
                                        <StackPanel HorizontalAlignment="Right">
                                            <TextBlock x:Uid="PerformancePage_Stat_Usage" IsTextSelectionEnabled="True" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" />
                                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                                                <TextBlock x:Name="CpuUsageBigText" IsTextSelectionEnabled="True" Text="0%" Style="{ThemeResource TitleTextBlockStyle}" FontSize="28" FontWeight="Bold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                                <Button Style="{StaticResource SubtleCopyButtonStyle}" Click="CopyButton_Click" Tag="CpuUsageBigText">
                                                    <FontIcon Glyph="&#xE8C8;" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel HorizontalAlignment="Right">
                                            <TextBlock x:Uid="PerformancePage_Stat_Speed" IsTextSelectionEnabled="True" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" />
                                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                                                <TextBlock x:Name="CpuClockBigText" IsTextSelectionEnabled="True" Text="-- GHz" Style="{ThemeResource TitleTextBlockStyle}" FontSize="28" FontWeight="Bold" />
                                                <Button Style="{StaticResource SubtleCopyButtonStyle}" Click="CopyButton_Click" Tag="CpuClockBigText">
                                                    <FontIcon Glyph="&#xE8C8;" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <!-- Big 60s Waveform Chart Card -->
                                <Border Height="180" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="{ThemeResource ControlCornerRadius}" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <Grid x:Name="CpuBigChartContainer">
                                        <!-- Horizontal Grid Lines -->
                                        <Rectangle Height="1" VerticalAlignment="Top" Margin="0,45,0,0" Fill="{ThemeResource TextFillColorSecondaryBrush}" Opacity="0.15" />
                                        <Rectangle Height="1" VerticalAlignment="Top" Margin="0,90,0,0" Fill="{ThemeResource TextFillColorSecondaryBrush}" Opacity="0.15" />
                                        <Rectangle Height="1" VerticalAlignment="Top" Margin="0,135,0,0" Fill="{ThemeResource TextFillColorSecondaryBrush}" Opacity="0.15" />

                                        <!-- Vertical Grid Lines -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Rectangle Grid.Column="1" Width="1" HorizontalAlignment="Left" Fill="{ThemeResource TextFillColorSecondaryBrush}" Opacity="0.08" />
                                            <Rectangle Grid.Column="2" Width="1" HorizontalAlignment="Left" Fill="{ThemeResource TextFillColorSecondaryBrush}" Opacity="0.08" />
                                            <Rectangle Grid.Column="3" Width="1" HorizontalAlignment="Left" Fill="{ThemeResource TextFillColorSecondaryBrush}" Opacity="0.08" />
                                            <Rectangle Grid.Column="4" Width="1" HorizontalAlignment="Left" Fill="{ThemeResource TextFillColorSecondaryBrush}" Opacity="0.08" />
                                            <Rectangle Grid.Column="5" Width="1" HorizontalAlignment="Left" Fill="{ThemeResource TextFillColorSecondaryBrush}" Opacity="0.08" />
                                        </Grid>

                                        <Polygon x:Name="CpuPolygon" Fill="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.15" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                        <Polyline x:Name="CpuPolyline" Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="2" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                        
                                        <!-- Caption Overlay -->
                                        <TextBlock x:Uid="PerformancePage_Chart_Cpu_Usage" IsTextSelectionEnabled="True" Margin="12,8" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Top" />
                                    </Grid>
                                </Border>

                                <!-- Specifications 3-Column Grid (Fluent Dual-Column Label/Value Layout) -->
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Column 1: Live Status -->
                                    <Border Grid.Column="0" VerticalAlignment="Stretch" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="16">
                                        <StackPanel Spacing="10">
                                            <TextBlock x:Uid="PerformancePage_Section_LiveStatus" IsTextSelectionEnabled="True" Style="{ThemeResource BodyStrongTextBlockStyle}" FontWeight="SemiBold" />
                                            <Grid RowSpacing="6">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                
                                                <TextBlock Grid.Row="0" Grid.Column="0" x:Uid="PerformancePage_Cpu_Clock" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="CpuClockText" Text="-- GHz" Style="{ThemeResource BodyStrongTextBlockStyle}" FontSize="13" IsTextSelectionEnabled="True" VerticalAlignment="Center" Margin="8,0,4,0" TextTrimming="CharacterEllipsis" />
                                                <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource SubtleCopyButtonStyle}" Click="CopyButton_Click" Tag="CpuClockText">
                                                    <FontIcon Glyph="&#xE8C8;" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                </Button>

                                                <TextBlock Grid.Row="1" Grid.Column="0" x:Uid="PerformancePage_Cpu_Temp" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="CpuTempText" Text="-- °C" Style="{ThemeResource BodyStrongTextBlockStyle}" FontSize="13" IsTextSelectionEnabled="True" VerticalAlignment="Center" Margin="8,0,4,0" TextTrimming="CharacterEllipsis" />
                                                <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource SubtleCopyButtonStyle}" Click="CopyButton_Click" Tag="CpuTempText">
                                                    <FontIcon Glyph="&#xE8C8;" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                </Button>

                                                <TextBlock Grid.Row="2" Grid.Column="0" x:Uid="PerformancePage_Cpu_Processes" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="CpuProcessesText" Text="--" Style="{ThemeResource BodyStrongTextBlockStyle}" FontSize="13" IsTextSelectionEnabled="True" VerticalAlignment="Center" Margin="8,0,4,0" TextTrimming="CharacterEllipsis" />
                                                <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource SubtleCopyButtonStyle}" Click="CopyButton_Click" Tag="CpuProcessesText">
                                                    <FontIcon Glyph="&#xE8C8;" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                </Button>

                                                <TextBlock Grid.Row="3" Grid.Column="0" x:Uid="PerformancePage_Cpu_Threads" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="CpuSystemThreadsText" Text="--" Style="{ThemeResource BodyStrongTextBlockStyle}" FontSize="13" IsTextSelectionEnabled="True" VerticalAlignment="Center" Margin="8,0,4,0" TextTrimming="CharacterEllipsis" />
                                                <Button Grid.Row="3" Grid.Column="2" Style="{StaticResource SubtleCopyButtonStyle}" Click="CopyButton_Click" Tag="CpuSystemThreadsText">
                                                    <FontIcon Glyph="&#xE8C8;" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                </Button>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Column 2: Processor Hardware Specs -->
                                    <Border Grid.Column="1" VerticalAlignment="Stretch" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="16">
                                        <StackPanel Spacing="10">
                                            <TextBlock x:Uid="PerformancePage_Section_ProcessorSpecs" IsTextSelectionEnabled="True" Style="{ThemeResource BodyStrongTextBlockStyle}" FontWeight="SemiBold" />
                                            <Grid RowSpacing="6">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                
                                                <TextBlock Grid.Row="0" Grid.Column="0" x:Uid="PerformancePage_Cpu_BaseSpeed" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="CpuBaseSpeedText" Text="--" Style="{ThemeResource BodyStrongTextBlockStyle}" FontSize="13" IsTextSelectionEnabled="True" VerticalAlignment="Center" Margin="8,0,4,0" TextTrimming="CharacterEllipsis" />
                                                <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource SubtleCopyButtonStyle}" Click="CopyButton_Click" Tag="CpuBaseSpeedText">
                                                    <FontIcon Glyph="&#xE8C8;" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                </Button>

                                                <TextBlock Grid.Row="1" Grid.Column="0" x:Uid="PerformancePage_Cpu_Sockets" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="CpuSocketsText" Text="--" Style="{ThemeResource BodyStrongTextBlockStyle}" FontSize="13" IsTextSelectionEnabled="True" VerticalAlignment="Center" Margin="8,0,4,0" TextTrimming="CharacterEllipsis" />
                                                <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource SubtleCopyButtonStyle}" Click="CopyButton_Click" Tag="CpuSocketsText">
                                                    <FontIcon Glyph="&#xE8C8;" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                </Button>

                                                <TextBlock Grid.Row="2" Grid.Column="0" x:Uid="PerformancePage_Cpu_Cores" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="CpuCoresText" Text="--" Style="{ThemeResource BodyStrongTextBlockStyle}" FontSize="13" IsTextSelectionEnabled="True" VerticalAlignment="Center" Margin="8,0,4,0" TextTrimming="CharacterEllipsis" />
                                                <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource SubtleCopyButtonStyle}" Click="CopyButton_Click" Tag="CpuCoresText">
                                                    <FontIcon Glyph="&#xE8C8;" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                </Button>

                                                <TextBlock Grid.Row="3" Grid.Column="0" x:Uid="PerformancePage_Cpu_LogicalCores" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="CpuLogicalCoresText" Text="--" Style="{ThemeResource BodyStrongTextBlockStyle}" FontSize="13" IsTextSelectionEnabled="True" VerticalAlignment="Center" Margin="8,0,4,0" TextTrimming="CharacterEllipsis" />
                                                <Button Grid.Row="3" Grid.Column="2" Style="{StaticResource SubtleCopyButtonStyle}" Click="CopyButton_Click" Tag="CpuLogicalCoresText">
                                                    <FontIcon Glyph="&#xE8C8;" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                </Button>

                                                <TextBlock Grid.Row="4" Grid.Column="0" x:Uid="PerformancePage_Cpu_Virtualization" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="CpuVirtualizationText" Text="--" Style="{ThemeResource BodyStrongTextBlockStyle}" FontSize="13" IsTextSelectionEnabled="True" VerticalAlignment="Center" Margin="8,0,4,0" TextTrimming="CharacterEllipsis" />
                                                <Button Grid.Row="4" Grid.Column="2" Style="{StaticResource SubtleCopyButtonStyle}" Click="CopyButton_Click" Tag="CpuVirtualizationText">
                                                    <FontIcon Glyph="&#xE8C8;" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                </Button>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Column 3: Cache Specs -->
                                    <Border Grid.Column="2" VerticalAlignment="Stretch" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="16">
                                        <StackPanel Spacing="10">
                                            <TextBlock x:Uid="PerformancePage_Section_CacheSpecs" IsTextSelectionEnabled="True" Style="{ThemeResource BodyStrongTextBlockStyle}" FontWeight="SemiBold" />
                                            <Grid RowSpacing="6">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                
                                                <TextBlock Grid.Row="0" Grid.Column="0" x:Uid="PerformancePage_Cpu_L1" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="CpuL1Text" Text="--" Style="{ThemeResource BodyStrongTextBlockStyle}" FontSize="13" IsTextSelectionEnabled="True" VerticalAlignment="Center" Margin="8,0,4,0" TextTrimming="CharacterEllipsis" />
                                                <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource SubtleCopyButtonStyle}" Click="CopyButton_Click" Tag="CpuL1Text">
                                                    <FontIcon Glyph="&#xE8C8;" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                </Button>

                                                <TextBlock Grid.Row="1" Grid.Column="0" x:Uid="PerformancePage_Cpu_L2" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
