<Page
    x:Class="lanlanlu_toolkit.Views.InputTesterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:lanlanlu_toolkit.Views"
    xmlns:services="using:lanlanlu_toolkit.Services"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    SizeChanged="Page_SizeChanged"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded"
    KeyDown="Page_KeyDown"
    KeyUp="Page_KeyUp">

    <Page.Resources>
        <!-- Tab Transition Storyboards (Guaranteed smooth 60fps animation on EVERY switch) -->
        <Storyboard x:Name="FadeInKeyboardStoryboard">
            <DoubleAnimation Storyboard.TargetName="KeyboardSection"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.20">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="KeyboardSectionTransform"
                             Storyboard.TargetProperty="Y"
                             From="10" To="0" Duration="0:0:0.20">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Name="FadeInMouseStoryboard">
            <DoubleAnimation Storyboard.TargetName="MouseSection"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.20">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="MouseSectionTransform"
                             Storyboard.TargetProperty="Y"
                             From="10" To="0" Duration="0:0:0.20">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Keycap Dynamic ThemeResource Styles -->
        <Style x:Key="KeycapDefaultStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        </Style>

        <Style x:Key="KeycapPressedStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
        </Style>

        <Style x:Key="KeycapTestedStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
        </Style>

        <Style x:Key="KeycapWarningStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource SystemFillColorCriticalBrush}" />
        </Style>

        <!-- Focus Badge Dynamic ThemeResource Styles -->
        <Style x:Key="FocusBadgeDefaultStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        </Style>

        <Style x:Key="FocusBadgeActiveStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
        </Style>

        <!-- Focus Badge Content Dynamic ThemeResource Styles -->
        <Style x:Key="FocusStatusIconDefaultStyle" TargetType="FontIcon">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="FocusStatusIconActiveStyle" TargetType="FontIcon">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" />
        </Style>

        <Style x:Key="FocusStatusTextDefaultStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="FocusStatusTextActiveStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        </Style>

        <!-- Keycap Text Dynamic ThemeResource Styles -->
        <Style x:Key="KeycapMainTextDefaultStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="KeycapMainTextTestedStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource AccentFillColorDefaultBrush}" />
        </Style>

        <Style x:Key="KeycapMainTextPressedStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="KeycapSubTextDefaultStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="KeycapSubTextPressedStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
        </Style>
    </Page.Resources>

    <Grid>
        <ScrollViewer x:Name="PageScrollViewer"
                      VerticalScrollBarVisibility="Auto"
                      VerticalScrollMode="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      HorizontalScrollMode="Disabled"
                      IsScrollInertiaEnabled="True">
            <Grid x:Name="RootContentGrid"
                  Padding="36,16,36,20"
                  HorizontalAlignment="Stretch"
                  SizeChanged="RootContentGrid_SizeChanged">
                <StackPanel Spacing="12" MaxWidth="1600" HorizontalAlignment="Stretch">
                    
                    <!-- Page Header & Action Bar -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="4">
                            <TextBlock x:Uid="InputTesterPage_Title" Style="{ThemeResource TitleTextBlockStyle}" />
                            <TextBlock x:Uid="InputTesterPage_Subtitle" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <!-- Top Right Controls -->
                        <Button x:Name="ResetBtn"
                                Grid.Column="1"
                                Click="ResetBtn_Click"
                                VerticalAlignment="Center"
                                Style="{ThemeResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                <TextBlock x:Uid="InputTesterPage_ResetBtn" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Fluent Design Settings-Style Options Section (2 Rows) -->
                    <StackPanel Spacing="4">
                        <!-- Card 1: Testing Mode Card (with ComboBox on the right) -->
                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{ThemeResource ControlCornerRadius}">
                            <Grid Padding="16,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE790;" 
                                          FontSize="18" 
                                          Margin="0,0,16,0" 
                                          VerticalAlignment="Center" 
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock x:Uid="InputTesterPage_Setting_ModeTitle" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock x:Uid="InputTesterPage_Setting_ModeDesc" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ComboBox x:Name="ModeComboBox"
                                          Grid.Column="2"
                                          Width="200"
                                          SelectedIndex="0"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Right"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          ScrollViewer.HorizontalScrollMode="Disabled"
                                          SelectionChanged="ModeComboBox_SelectionChanged">
                                    <ComboBoxItem x:Name="KeyboardComboItem">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE765;" FontSize="16" />
                                            <TextBlock x:Uid="InputTesterPage_Tab_Keyboard" />
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem x:Name="MouseComboItem">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE962;" FontSize="16" />
                                            <TextBlock x:Uid="InputTesterPage_Tab_Mouse" />
                                        </StackPanel>
                                    </ComboBoxItem>
                                </ComboBox>
                            </Grid>
                        </Border>

                        <!-- Card 2: Audio Feedback Toggle Card (with ToggleSwitch on the right) -->
                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{ThemeResource ControlCornerRadius}">
                            <Grid Padding="16,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE767;" 
                                          FontSize="18" 
                                          Margin="0,0,16,0" 
                                          VerticalAlignment="Center" 
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock x:Uid="InputTesterPage_Setting_SoundTitle" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock x:Uid="InputTesterPage_Setting_SoundDesc" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Right">
                                    <TextBlock x:Name="SoundToggleStateText"
                                               Style="{ThemeResource BodyTextBlockStyle}"
                                               VerticalAlignment="Center" />
                                    <ToggleSwitch x:Name="SoundToggle"
                                                  IsOn="True"
                                                  MinWidth="0"
                                                  Header="{x:Null}"
                                                  OnContent="" OffContent=""
                                                  Margin="0,0,-12,0"
                                                  VerticalAlignment="Center"
                                                  Toggled="SoundToggle_Toggled" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- ========================================================================= -->
                    <!-- 1. KEYBOARD TESTING SECTION                                               -->
                    <!-- ========================================================================= -->
                    <StackPanel x:Name="KeyboardSection" Spacing="12" HorizontalAlignment="Stretch">
                        <StackPanel.RenderTransform>
                            <TranslateTransform x:Name="KeyboardSectionTransform" />
                        </StackPanel.RenderTransform>
                        
                        <!-- Summary Stat Cards Grid (5 Columns with 100% Uniform Height & 3-Row Alignment) -->
                        <Grid ColumnSpacing="12" HorizontalAlignment="Stretch">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Card 1: Last Key Pressed -->
                            <Border Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="14,10"
                                    VerticalAlignment="Stretch" MinHeight="76">
                                <Grid ColumnSpacing="12" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE751;" FontSize="22" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    <Grid Grid.Column="1" RowSpacing="2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" x:Uid="InputTesterPage_Card_LastKey" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Row="1" x:Name="LastKeyText" Text="-" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Row="2" x:Name="LastKeyCodeText" x:Uid="InputTesterPage_Key_CodeEmpty" Text="VK: - | Scan: -" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Card 2: Current Active Down -->
                            <Border Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="14,10"
                                    VerticalAlignment="Stretch" MinHeight="76">
                                <Grid ColumnSpacing="12" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xEB97;" FontSize="22" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    <Grid Grid.Column="1" RowSpacing="2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" x:Uid="InputTesterPage_Card_CurrentKeys" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Row="1" x:Name="CurrentDownText" Text="0" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="2" x:Name="ActiveKeyListText" x:Uid="InputTesterPage_Key_None" Text="無" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Card 3: Max Rollover (NKRO) -->
                            <Border Grid.Column="2" Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="14,10"
                                    VerticalAlignment="Stretch" MinHeight="76">
                                <Grid ColumnSpacing="12" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE73F;" FontSize="22" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    <Grid Grid.Column="1" RowSpacing="2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" x:Uid="InputTesterPage_Card_MaxRollover" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Row="1" x:Name="MaxRolloverText" Text="0" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="2" x:Uid="InputTesterPage_Card_NKRO" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Card 4: Total Presses -->
                            <Border Grid.Column="3" Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="14,10"
                                    VerticalAlignment="Stretch" MinHeight="76">
                                <Grid ColumnSpacing="12" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xF261;" FontSize="22" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    <Grid Grid.Column="1" RowSpacing="2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" x:Uid="InputTesterPage_Card_TotalPresses" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Row="1" x:Name="TotalPressesText" Text="0" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="2" x:Name="TestedKeysCountText" Text="0 / 104 鍵" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Card 5: Trigger Interval & Chatter Warning -->
                            <Border Grid.Column="4" Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="14,10"
                                    VerticalAlignment="Stretch" MinHeight="76">
                                <Grid ColumnSpacing="12" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE916;" FontSize="22" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    <Grid Grid.Column="1" RowSpacing="2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" x:Uid="InputTesterPage_Card_KeyInterval" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Row="1" x:Name="KeyIntervalText" Text="-" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="2" x:Name="KeyChatterStatusText" x:Uid="InputTesterPage_Key_ChatterNormal" Text="正常" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Keyboard Interactive Vector Stage with Focus State Wrapper -->
                        <Border x:Name="KeyboardFocusArea"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{ThemeResource OverlayCornerRadius}"
                                Padding="16,12,16,16"
                                IsTabStop="True"
                                SizeChanged="KeyboardFocusArea_SizeChanged"
                                GotFocus="KeyboardFocusArea_GotFocus"
                                LostFocus="KeyboardFocusArea_LostFocus"
                                PointerPressed="KeyboardFocusArea_PointerPressed">
                            <StackPanel Spacing="8">
                                <!-- Keyboard Header Bar: Title + Layout Dropdown + Real-time Focus Status Badge -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE765;" FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="KeyboardLayoutTitleText"
                                                   x:Uid="InputTesterPage_LayoutTitle_100"
                                                   Style="{ThemeResource SubtitleTextBlockStyle}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>

                                    <!-- Layout Selector & Focus Status Badge -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                        <ComboBox x:Name="KeyboardLayoutComboBox"
                                                  SelectedIndex="0"
                                                  SelectionChanged="KeyboardLayoutComboBox_SelectionChanged"
                                                  VerticalAlignment="Center"
                                                  MinWidth="190"
                                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                  ScrollViewer.HorizontalScrollMode="Disabled">
                                            <ComboBoxItem x:Uid="InputTesterPage_Layout_100" />
                                            <ComboBoxItem x:Uid="InputTesterPage_Layout_80" />
                                            <ComboBoxItem x:Uid="InputTesterPage_Layout_60" />
                                        </ComboBox>

                                        <!-- Focus Status Badge Indicator with Fluent Icon -->
                                        <Border x:Name="FocusStatusBadge"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource FocusBadgeDefaultStyle}"
                                                Padding="10,4"
                                                PointerPressed="KeyboardFocusArea_PointerPressed">
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <FontIcon x:Name="FocusStatusIcon"
                                                          Glyph="&#xE765;"
                                                          Style="{StaticResource FocusStatusIconDefaultStyle}"
                                                          VerticalAlignment="Center" />
                                                <TextBlock x:Name="FocusStatusText"
                                                           x:Uid="InputTesterPage_FocusStatus_Unfocused"
                                                           Text="點擊以聚焦輸入"
                                                           Style="{StaticResource FocusStatusTextDefaultStyle}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- Vector Layout Keyboard Stage (Mathematical Sub-pixel Alignment) -->
                                <Viewbox x:Name="KeyboardViewbox"
                                         Stretch="Uniform"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         MaxHeight="275"
                                         UseLayoutRounding="False">
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="16"
                                                Padding="8"
                                                UseLayoutRounding="False"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <!-- Main 60% Cluster (714px) -->
                                        <StackPanel x:Name="MainClusterPanel"
                                                    Spacing="4"
                                                    UseLayoutRounding="False"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Top" />

                                        <!-- Nav / Arrow Cluster (138px) -->
                                        <StackPanel x:Name="NavClusterPanel"
                                                    Spacing="4"
                                                    UseLayoutRounding="False"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Top" />

                                        <!-- Numpad Cluster (186px) -->
                                        <Grid x:Name="NumpadClusterGrid"
                                              UseLayoutRounding="False"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Top"
                                              RowSpacing="4"
                                              ColumnSpacing="8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="42" />
                                                <RowDefinition Height="42" />
                                                <RowDefinition Height="42" />
                                                <RowDefinition Height="42" />
                                                <RowDefinition Height="42" />
                                                <RowDefinition Height="42" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42" />
                                                <ColumnDefinition Width="42" />
                                                <ColumnDefinition Width="42" />
                                                <ColumnDefinition Width="42" />
                                            </Grid.ColumnDefinitions>
                                        </Grid>
                                    </StackPanel>
                                </Viewbox>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ========================================================================= -->
                    <!-- 2. MOUSE TESTING SECTION                                                  -->
                    <!-- ========================================================================= -->
                    <StackPanel x:Name="MouseSection"
                                Visibility="Collapsed"
                                Spacing="16"
                                HorizontalAlignment="Stretch">
                        <StackPanel.RenderTransform>
                            <TranslateTransform x:Name="MouseSectionTransform" />
                        </StackPanel.RenderTransform>
                        
                        <!-- Summary Stat Cards Grid (5 Columns with 100% Uniform Height & 3-Row Alignment) -->
                        <Grid ColumnSpacing="12" HorizontalAlignment="Stretch">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Card 1: Last Triggered Mouse Button -->
                            <Border Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="14,10"
                                    VerticalAlignment="Stretch" MinHeight="76">
                                <Grid ColumnSpacing="12" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE751;" FontSize="22" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    <Grid Grid.Column="1" RowSpacing="2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" x:Uid="InputTesterPage_MouseCard_LastButton" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Row="1" x:Name="LastMouseBtnText" Text="-" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Row="2" x:Name="LastMouseActionText" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Card 2: Total Clicks & Counts Breakdown -->
                            <Border Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="14,10"
                                    VerticalAlignment="Stretch" MinHeight="76">
                                <Grid ColumnSpacing="12" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xF261;" FontSize="22" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    <Grid Grid.Column="1" RowSpacing="2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" x:Uid="InputTesterPage_MouseCard_TotalClicks" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Row="1" x:Name="MouseTotalClicksCountText" Text="0" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="2" x:Name="MouseClicksBreakdownText" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Card 3: Sensor Polling Rate (Hz) -->
                            <Border Grid.Column="2" Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="14,10"
                                    VerticalAlignment="Stretch" MinHeight="76">
                                <Grid ColumnSpacing="12" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xEC49;" FontSize="22" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    <Grid Grid.Column="1" RowSpacing="2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" x:Uid="InputTesterPage_MouseCard_PollingRate" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Row="1" x:Name="MouseCurrentHzSummaryText" Text="0 Hz" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="2" x:Name="HzSummaryText" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Card 4: Scroll Wheel Measurement -->
                            <Border Grid.Column="3" Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="14,10"
                                    VerticalAlignment="Stretch" MinHeight="76">
                                <Grid ColumnSpacing="12" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xEC8F;" FontSize="22" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    <Grid Grid.Column="1" RowSpacing="2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" x:Uid="InputTesterPage_MouseCard_WheelDelta" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Row="1" x:Name="WheelStepsSummaryText" Text="0" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE70E;" FontSize="9" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                            <TextBlock x:Name="WheelUpCountText" Text="0" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                            <Border Width="1" Height="8" Background="{ThemeResource CardStrokeColorDefaultBrush}" VerticalAlignment="Center" Margin="2,0" />
                                            <FontIcon Glyph="&#xE70D;" FontSize="9" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                            <TextBlock x:Name="WheelDownCountText" Text="0" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                            <Border Width="1" Height="8" Background="{ThemeResource CardStrokeColorDefaultBrush}" VerticalAlignment="Center" Margin="2,0" />
                                            <TextBlock x:Name="WheelStatusSummaryText" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Card 5: Switch Chatter & Health Status -->
                            <Border Grid.Column="4" Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="14,10"
                                    VerticalAlignment="Stretch" MinHeight="76">
                                <Grid ColumnSpacing="12" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE8B0;" FontSize="22" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    <Grid Grid.Column="1" RowSpacing="2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" x:Uid="InputTesterPage_MouseCard_Chatter" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Row="1" x:Name="ChatterStatusSummaryText" Text="-" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="2" x:Name="ChatterCountsText" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- 3-Column Interactive Stages Grid (1 Row: Mouse Visual + Chatter Tester + Sensor Canvas) -->
                        <Grid ColumnSpacing="12" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Card 1: Interactive Vector Mouse Dashboard -->
                            <Border Grid.Column="0"
                                    x:Name="MouseVisualCard"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{ThemeResource OverlayCornerRadius}"
                                    Padding="14"
                                    VerticalAlignment="Stretch"
                                    PointerWheelChanged="MouseVisualCard_PointerWheelChanged">
                                <Grid RowSpacing="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Header -->
                                    <StackPanel Grid.Row="0" Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE790;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                            <TextBlock x:Uid="InputTesterPage_Mouse_VisualTitle" Style="{ThemeResource SubtitleTextBlockStyle}" FontSize="15" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock x:Uid="InputTesterPage_Mouse_VisualDesc" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <!-- Vector Mouse Interactive Visual Graphic -->
                                    <Grid Grid.Row="1" Width="190" Height="200" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <!-- Mouse Base Silhouette Body -->
                                        <Border Width="144" Height="190"
                                                CornerRadius="58,58,68,68"
                                                Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1.5"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />

                                        <!-- Top Left Button (Left Click) -->
                                        <Border x:Name="MouseLeftBtnVisual"
                                                Width="56" Height="72"
                                                CornerRadius="50,6,4,4"
                                                Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                Margin="0,0,60,94"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                            <TextBlock x:Name="MouseLeftCountText" Text="0" Style="{ThemeResource SubtitleTextBlockStyle}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <!-- Top Right Button (Right Click) -->
                                        <Border x:Name="MouseRightBtnVisual"
                                                Width="56" Height="72"
                                                CornerRadius="6,50,4,4"
                                                Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                Margin="60,0,0,94"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                            <TextBlock x:Name="MouseRightCountText" Text="0" Style="{ThemeResource SubtitleTextBlockStyle}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <!-- Scroll Wheel Visual -->
                                        <Border x:Name="MouseMiddleBtnVisual"
                                                Width="20" Height="42"
                                                CornerRadius="10"
                                                Background="{ThemeResource ControlSolidFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                Margin="0,0,0,88"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="2">
                                                <FontIcon x:Name="WheelUpArrow" Glyph="&#xE70E;" FontSize="8" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                                                <FontIcon x:Name="WheelMiddleIcon" Glyph="&#xE700;" FontSize="9" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                                <FontIcon x:Name="WheelDownArrow" Glyph="&#xE70D;" FontSize="8" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Side Button 1 (Back) -->
                                        <Border x:Name="MouseSide1BtnVisual"
                                                Width="10" Height="28"
                                                CornerRadius="5,0,0,5"
                                                Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                Margin="0,16,148,0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                            <TextBlock x:Name="MouseSide1Text" Text="1" FontSize="8" FontWeight="Bold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <!-- Side Button 2 (Forward) -->
                                        <Border x:Name="MouseSide2BtnVisual"
                                                Width="10" Height="28"
                                                CornerRadius="5,0,0,5"
                                                Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                Margin="0,0,148,42"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                            <TextBlock x:Name="MouseSide2Text" Text="2" FontSize="8" FontWeight="Bold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                    </Grid>

                                    <!-- Streamlined Micro-Stats: Side Button 1 and Side Button 2 -->
                                    <Grid Grid.Row="2" ColumnSpacing="8" HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Tile 1: Side Button 1 -->
                                        <Border Grid.Column="0"
                                                Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="10,6">
                                            <StackPanel Spacing="2">
                                                <TextBlock x:Uid="InputTesterPage_MouseTile_Side1" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock x:Name="Side1CountText" Text="0" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Tile 2: Side Button 2 -->
                                        <Border Grid.Column="1"
                                                Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="10,6">
                                            <StackPanel Spacing="2">
                                                <TextBlock x:Uid="InputTesterPage_MouseTile_Side2" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock x:Name="Side2CountText" Text="0" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Wheel Guidance Tip Badge -->
                                    <Border Grid.Row="3"
                                            Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{ThemeResource ControlCornerRadius}"
                                            Padding="10,4">
                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                            <FontIcon Glyph="&#xE946;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                            <TextBlock x:Uid="InputTesterPage_Mouse_WheelHint"
                                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Card 2: Switch Chatter & Double-Click Tester -->
                            <Border Grid.Column="1"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{ThemeResource OverlayCornerRadius}"
                                    Padding="14"
                                    VerticalAlignment="Stretch">
                                <Grid RowSpacing="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Header -->
                                    <StackPanel Grid.Row="0" Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE8B0;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                            <TextBlock x:Uid="InputTesterPage_Mouse_ChatterTest_Title" Style="{ThemeResource SubtitleTextBlockStyle}" FontSize="15" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock x:Uid="InputTesterPage_Mouse_ChatterTest_Desc" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <!-- Threshold Slider Row -->
                                    <Grid Grid.Row="1" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" x:Uid="InputTesterPage_Mouse_Threshold" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                        <Slider Grid.Column="1" x:Name="ChatterThresholdSlider" Minimum="20" Maximum="150" Value="80" StepFrequency="5" ValueChanged="ChatterThresholdSlider_ValueChanged" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" x:Name="ChatterThresholdValueText" Text="80 ms" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" Width="44" TextAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- Interactive Clickable Test Area -->
                                    <Border Grid.Row="2"
                                            x:Name="ChatterClickPad"
                                            Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{ThemeResource ControlCornerRadius}"
                                            VerticalAlignment="Stretch"
                                            MinHeight="140"
                                            PointerPressed="ChatterClickPad_PointerPressed"
                                            PointerReleased="ChatterClickPad_PointerReleased">
                                        <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock x:Name="LastClickIntervalText" Style="{ThemeResource SubtitleTextBlockStyle}" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>

                                    <!-- Bottom Status / Guidance Badge -->
                                    <Border Grid.Row="3"
                                            x:Name="ChatterStatusBorder"
                                            Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{ThemeResource ControlCornerRadius}"
                                            Padding="10,4">
                                        <Grid>
                                            <!-- Normal Guidance State -->
                                            <StackPanel x:Name="ChatterNormalHint"
                                                        Orientation="Horizontal"
                                                        Spacing="6"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE946;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                <TextBlock x:Uid="InputTesterPage_Mouse_ChatterHint"
                                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <!-- Chatter Warning State -->
                                            <StackPanel x:Name="ChatterAlertBanner"
                                                        Orientation="Horizontal"
                                                        Spacing="6"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Visibility="Collapsed">
                                                <FontIcon Glyph="&#xE7BA;" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" VerticalAlignment="Center" />
                                                <TextBlock x:Uid="InputTesterPage_Mouse_ChatterBanner"
                                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Card 3: Sensor Polling Rate (Hz) & Trajectory Smoothness Canvas -->
                            <Border Grid.Column="2"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{ThemeResource OverlayCornerRadius}"
                                    Padding="14"
                                    VerticalAlignment="Stretch">
                                <Grid RowSpacing="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Header (Title on Left, Clear Button on Right) -->
                                    <Grid Grid.Row="0" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0" ColumnSpacing="8" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Grid.Column="0" Glyph="&#xEE56;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" x:Uid="InputTesterPage_Mouse_Canvas_Title" Style="{ThemeResource SubtitleTextBlockStyle}" FontSize="15" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                        <Button Grid.Column="1" Click="ClearCanvasBtn_Click" VerticalAlignment="Center" Padding="8,4">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE75C;" FontSize="12" />
                                                <TextBlock x:Uid="InputTesterPage_Mouse_Canvas_Clear" Style="{ThemeResource CaptionTextBlockStyle}" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <!-- Description & Polling Hz Compact Chips Pill -->
                                    <StackPanel Grid.Row="1" Spacing="6">
                                        <TextBlock x:Uid="InputTesterPage_Mouse_Canvas_Desc" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                        
                                        <Border Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{ThemeResource ControlCornerRadius}"
                                                Padding="8,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <!-- Realtime -->
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                                    <TextBlock x:Uid="InputTesterPage_Mouse_RealtimeChip" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock x:Name="CurrentHzText" Text="0 Hz" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="Bold" />
                                                </StackPanel>
                                                <Border Grid.Column="1" Width="1" Height="10" Background="{ThemeResource CardStrokeColorDefaultBrush}" VerticalAlignment="Center" Margin="2,0" />
                                                <!-- Avg -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                                    <TextBlock x:Uid="InputTesterPage_Mouse_AvgChip" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock x:Name="AvgHzText" Text="0 Hz" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="Bold" />
                                                </StackPanel>
                                                <Border Grid.Column="3" Width="1" Height="10" Background="{ThemeResource CardStrokeColorDefaultBrush}" VerticalAlignment="Center" Margin="2,0" />
                                                <!-- Peak -->
                                                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                                    <TextBlock x:Uid="InputTesterPage_Mouse_PeakChip" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock x:Name="PeakHzText" Text="0 Hz" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="Bold" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                    <!-- Large Interactive Drawing Canvas Area -->
                                    <Border Grid.Row="2"
                                            Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{ThemeResource ControlCornerRadius}"
                                            VerticalAlignment="Stretch"
                                            MinHeight="140">
                                        <Canvas x:Name="TrajectoryCanvas"
                                                Background="Transparent"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"
                                                PointerPressed="TrajectoryCanvas_PointerPressed"
                                                PointerMoved="TrajectoryCanvas_PointerMoved"
                                                PointerReleased="TrajectoryCanvas_PointerReleased" />
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
