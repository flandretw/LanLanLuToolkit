<Page
    x:Class="lanlanlu_toolkit.Views.InputTesterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent"
    SizeChanged="Page_SizeChanged"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded"
    KeyDown="Page_KeyDown"
    KeyUp="Page_KeyUp">
    <Page.Resources>
        <!-- Tab Transition Storyboards (Guaranteed smooth 60fps animation on EVERY switch) -->
        <Storyboard x:Name="FadeInKeyboardStoryboard">
            <DoubleAnimation Storyboard.TargetName="KeyboardSection"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.20">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="KeyboardSectionTransform"
                             Storyboard.TargetProperty="Y"
                             From="10" To="0" Duration="0:0:0.20">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Name="FadeInMouseStoryboard">
            <DoubleAnimation Storyboard.TargetName="MouseSection"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.20">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="MouseSectionTransform"
                             Storyboard.TargetProperty="Y"
                             From="10" To="0" Duration="0:0:0.20">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <!-- Keycap Dynamic ThemeResource Styles -->
        <Style x:Key="KeycapDefaultStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        </Style>
        <Style x:Key="KeycapPressedStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
        </Style>
        <Style x:Key="KeycapTestedStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
        </Style>
        <Style x:Key="KeycapWarningStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource SystemFillColorCriticalBrush}" />
        </Style>
        <!-- Focus Badge Dynamic ThemeResource Styles -->
        <Style x:Key="FocusBadgeDefaultStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        </Style>
        <Style x:Key="FocusBadgeActiveStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
        </Style>
        <!-- Focus Badge Content Dynamic ThemeResource Styles -->
        <Style x:Key="FocusStatusIconDefaultStyle" TargetType="FontIcon">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="FocusStatusIconActiveStyle" TargetType="FontIcon">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" />
        </Style>
        <Style x:Key="FocusStatusTextDefaultStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="FocusStatusTextActiveStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        </Style>
        <!-- Keycap Text Dynamic ThemeResource Styles -->
        <Style x:Key="KeycapMainTextDefaultStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="KeycapMainTextTestedStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource AccentFillColorDefaultBrush}" />
        </Style>
        <Style x:Key="KeycapMainTextPressedStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="KeycapSubTextDefaultStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="KeycapSubTextPressedStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
        </Style>
    </Page.Resources>
    <Grid>
        <ScrollViewer x:Name="PageScrollViewer"
                      VerticalScrollBarVisibility="Auto"
                      VerticalScrollMode="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      HorizontalScrollMode="Disabled"
                      IsScrollInertiaEnabled="True">
            <Grid x:Name="RootContentGrid"
                  Padding="36,24,36,24"
                  HorizontalAlignment="Stretch"
                  SizeChanged="RootContentGrid_SizeChanged">
                <StackPanel Spacing="12" MaxWidth="1600" HorizontalAlignment="Stretch">
                    <!-- Page Header: Title + Subtitle on left, Actions on right -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Title & Subtitle -->
                        <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                            <TextBlock x:Uid="InputTesterPage_Title" Style="{ThemeResource TitleTextBlockStyle}" />
                            <TextBlock x:Uid="InputTesterPage_Subtitle" Style="{StaticResource PageHeaderSubtitleStyle}" />
                        </StackPanel>

                        <!-- Top Right Controls: Standard Reset Button -->
                        <StackPanel Grid.Column="1" Style="{StaticResource PageHeaderActionsPanelStyle}">
                            <Button x:Name="ResetBtn" Click="ResetBtn_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE72C;" FontSize="15" VerticalAlignment="Center" />
                                    <TextBlock x:Uid="InputTesterPage_ResetBtn" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Windows 11 Fluent Native SelectorBar for Mode Switching -->
                    <SelectorBar x:Name="InputModeSelectorBar"
                                 HorizontalAlignment="Left"
                                 Margin="0,0,0,4"
                                 SelectionChanged="InputModeSelectorBar_SelectionChanged">
                        <SelectorBarItem x:Name="KeyboardSelectorItem"
                                         x:Uid="InputTesterPage_Tab_Keyboard">
                            <SelectorBarItem.Icon>
                                <FontIcon Glyph="&#xE765;" />
                            </SelectorBarItem.Icon>
                        </SelectorBarItem>
                        <SelectorBarItem x:Name="MouseSelectorItem"
                                         x:Uid="InputTesterPage_Tab_Mouse">
                            <SelectorBarItem.Icon>
                                <FontIcon Glyph="&#xE962;" />
                            </SelectorBarItem.Icon>
                        </SelectorBarItem>
                    </SelectorBar>
                    <!-- ========================================================================= -->
                    <!-- 1. KEYBOARD TESTING SECTION                                               -->
                    <!-- ========================================================================= -->
                    <StackPanel x:Name="KeyboardSection" Spacing="12" HorizontalAlignment="Stretch">
                        <StackPanel.RenderTransform>
                            <TranslateTransform x:Name="KeyboardSectionTransform" />
                        </StackPanel.RenderTransform>
                        <!-- Keyboard Diagnostic Cards (HomePage style: 24px Icon + Two-line text) -->
                        <Grid ColumnSpacing="12" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Col 0: Last Key -->
                            <Border Grid.Column="0" Style="{StaticResource FluentCardBorderStyle}" Padding="16,10">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE765;" FontSize="24" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock x:Uid="InputTesterPage_Card_LastKey" Style="{ThemeResource BodyStrongTextBlockStyle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" x:Name="LastKeyText" Text="-" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource AccentFillColorDefaultBrush}" FontWeight="SemiBold" TextWrapping="NoWrap" />
                                            <TextBlock Grid.Column="1" x:Name="LastKeyCodeText" x:Uid="InputTesterPage_Key_CodeEmpty" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Col 1: Active Down -->
                            <Border Grid.Column="1" Style="{StaticResource FluentCardBorderStyle}" Padding="16,10">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE762;" FontSize="24" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock x:Uid="InputTesterPage_Card_CurrentKeys" Style="{ThemeResource BodyStrongTextBlockStyle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" x:Name="CurrentDownText" Text="0" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" TextWrapping="NoWrap" />
                                            <TextBlock Grid.Column="1" x:Name="ActiveKeyListText" x:Uid="InputTesterPage_Key_None" Text="-" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Col 2: Max Rollover -->
                            <Border Grid.Column="2" Style="{StaticResource FluentCardBorderStyle}" Padding="16,10">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xEA18;" FontSize="24" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock x:Uid="InputTesterPage_Card_MaxRollover" Style="{ThemeResource BodyStrongTextBlockStyle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" x:Name="MaxRolloverText" Text="0" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" TextWrapping="NoWrap" />
                                            <TextBlock Grid.Column="1" x:Uid="InputTesterPage_Card_NKRO" Text="NKRO" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Col 3: Total Presses -->
                            <Border Grid.Column="3" Style="{StaticResource FluentCardBorderStyle}" Padding="16,10">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE9F9;" FontSize="24" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock x:Uid="InputTesterPage_Card_TotalPresses" Style="{ThemeResource BodyStrongTextBlockStyle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" x:Name="TotalPressesText" Text="0" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" TextWrapping="NoWrap" />
                                            <TextBlock Grid.Column="1" x:Name="TestedKeysCountText" Text="0 / 104" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                        <!-- Keyboard Interactive Vector Stage with Focus State Wrapper -->
                        <Border x:Name="KeyboardFocusArea"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{ThemeResource OverlayCornerRadius}"
                                Padding="16,12,16,16"
                                IsTabStop="True"
                                SizeChanged="KeyboardFocusArea_SizeChanged"
                                GotFocus="KeyboardFocusArea_GotFocus"
                                LostFocus="KeyboardFocusArea_LostFocus"
                                PointerPressed="KeyboardFocusArea_PointerPressed">
                            <StackPanel Spacing="8">
                                <!-- Keyboard Header Bar: Title + Layout Dropdown + Real-time Focus Status Badge -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE765;" FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="KeyboardLayoutTitleText"
                                                   x:Uid="InputTesterPage_LayoutTitle_100"
                                                   Style="{ThemeResource SubtitleTextBlockStyle}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <!-- Layout Selector & Focus Status Badge -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                        <ComboBox x:Name="KeyboardLayoutComboBox"
                                                  SelectedIndex="0"
                                                  SelectionChanged="KeyboardLayoutComboBox_SelectionChanged"
                                                  VerticalAlignment="Center"
                                                  MinWidth="190"
                                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                  ScrollViewer.HorizontalScrollMode="Disabled">
                                            <ComboBoxItem x:Uid="InputTesterPage_Layout_100" />
                                            <ComboBoxItem x:Uid="InputTesterPage_Layout_80" />
                                            <ComboBoxItem x:Uid="InputTesterPage_Layout_60" />
                                        </ComboBox>
                                        <!-- Focus Status Badge Indicator with Fluent Icon -->
                                        <Border x:Name="FocusStatusBadge"
                                                Width="88"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource FocusBadgeDefaultStyle}"
                                                Padding="0,4"
                                                PointerPressed="KeyboardFocusArea_PointerPressed">
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <FontIcon x:Name="FocusStatusIcon"
                                                          Glyph="&#xE765;"
                                                          Style="{StaticResource FocusStatusIconDefaultStyle}"
                                                          VerticalAlignment="Center" />
                                                <TextBlock x:Name="FocusStatusText"
                                                           x:Uid="InputTesterPage_FocusStatus_Unfocused"
                                                           Style="{StaticResource FocusStatusTextDefaultStyle}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                                <!-- Vector Layout Keyboard Stage (Mathematical Sub-pixel Alignment) -->
                                <Viewbox x:Name="KeyboardViewbox"
                                         Stretch="Uniform"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         MaxHeight="275"
                                         UseLayoutRounding="False">
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="16"
                                                Padding="8"
                                                UseLayoutRounding="False"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <!-- Main 60% Cluster (714px) -->
                                        <StackPanel x:Name="MainClusterPanel"
                                                    Spacing="4"
                                                    UseLayoutRounding="False"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Top" />
                                        <!-- Nav / Arrow Cluster (138px) -->
                                        <StackPanel x:Name="NavClusterPanel"
                                                    Spacing="4"
                                                    UseLayoutRounding="False"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Top" />
                                        <!-- Numpad Cluster (186px) -->
                                        <Grid x:Name="NumpadClusterGrid"
                                              UseLayoutRounding="False"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Top"
                                              RowSpacing="4"
                                              ColumnSpacing="8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="42" />
                                                <RowDefinition Height="42" />
                                                <RowDefinition Height="42" />
                                                <RowDefinition Height="42" />
                                                <RowDefinition Height="42" />
                                                <RowDefinition Height="42" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42" />
                                                <ColumnDefinition Width="42" />
                                                <ColumnDefinition Width="42" />
                                                <ColumnDefinition Width="42" />
                                            </Grid.ColumnDefinitions>
                                        </Grid>
                                    </StackPanel>
                                </Viewbox>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <!-- ========================================================================= -->
                    <!-- 2. MOUSE TESTING SECTION                                                  -->
                    <!-- ========================================================================= -->
                    <StackPanel x:Name="MouseSection"
                                Visibility="Collapsed"
                                Spacing="16"
                                HorizontalAlignment="Stretch">
                        <StackPanel.RenderTransform>
                            <TranslateTransform x:Name="MouseSectionTransform" />
                        </StackPanel.RenderTransform>
                        <!-- Mouse Diagnostic Cards (HomePage style: 24px Icon + Two-line text) -->
                        <Grid ColumnSpacing="12" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Col 0: Last Button -->
                            <Border Grid.Column="0" Style="{StaticResource FluentCardBorderStyle}" Padding="16,10">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE962;" FontSize="24" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock x:Uid="InputTesterPage_MouseCard_LastButton" Style="{ThemeResource BodyStrongTextBlockStyle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" x:Name="LastMouseBtnText" Text="-" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource AccentFillColorDefaultBrush}" FontWeight="SemiBold" TextWrapping="NoWrap" />
                                            <TextBlock Grid.Column="1" x:Name="LastMouseActionText" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Col 1: Total Clicks -->
                            <Border Grid.Column="1" Style="{StaticResource FluentCardBorderStyle}" Padding="16,10">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE9F9;" FontSize="24" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock x:Uid="InputTesterPage_MouseCard_TotalClicks" Style="{ThemeResource BodyStrongTextBlockStyle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" x:Name="MouseTotalClicksCountText" Text="0" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" TextWrapping="NoWrap" />
                                            <TextBlock Grid.Column="1" x:Name="MouseClicksBreakdownText" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Col 2: Polling Rate -->
                            <Border Grid.Column="2" Style="{StaticResource FluentCardBorderStyle}" Padding="16,10">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE9D9;" FontSize="24" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock x:Uid="InputTesterPage_MouseCard_PollingRate" Style="{ThemeResource BodyStrongTextBlockStyle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" x:Name="MouseCurrentHzSummaryText" Text="0 Hz" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" TextWrapping="NoWrap" />
                                            <TextBlock Grid.Column="1" x:Name="HzSummaryText" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Col 3: Switch Chatter -->
                            <Border Grid.Column="3" Style="{StaticResource FluentCardBorderStyle}" Padding="16,10">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE90F;" FontSize="24" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock x:Uid="InputTesterPage_MouseCard_Chatter" Style="{ThemeResource BodyStrongTextBlockStyle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" x:Name="ChatterStatusSummaryText" Text="-" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" TextWrapping="NoWrap" />
                                            <TextBlock Grid.Column="1" x:Name="ChatterCountsText" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                        <!-- Mouse Interactive Vector & Sensor Canvas Stage with Focus State Wrapper -->
                        <Border x:Name="MouseFocusArea"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{ThemeResource OverlayCornerRadius}"
                                Padding="16,12,16,16"
                                VerticalAlignment="Stretch"
                                PointerWheelChanged="MouseSection_PointerWheelChanged">
                            <StackPanel Spacing="12">
                                <!-- Mouse Header Bar: Title + Layout Dropdown (Matching Keyboard HUD) -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE962;" FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="MouseLayoutTitleText"
                                                   x:Uid="InputTesterPage_Mouse_StageTitle"
                                                   Style="{ThemeResource SubtitleTextBlockStyle}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <!-- Mouse Layout / Side Button Selector (Matching Keyboard Layout Dropdown) -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                        <ComboBox x:Name="MouseLayoutComboBox"
                                                  SelectedIndex="0"
                                                  SelectionChanged="MouseLayoutComboBox_SelectionChanged"
                                                  VerticalAlignment="Center"
                                                  MinWidth="190"
                                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                  ScrollViewer.HorizontalScrollMode="Disabled">
                                            <ComboBoxItem x:Uid="InputTesterPage_MouseLayout_NoSide" />
                                            <ComboBoxItem x:Uid="InputTesterPage_MouseLayout_WithSide" />
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <!-- 2-Column Responsive Workspace: Hardware Visual (Left) + Sensor & Trajectory Canvas (Right) -->
                                <Grid ColumnSpacing="16" HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="340" MinWidth="300" MaxWidth="380" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Left Column: Unified Interactive Vector Mouse Visual Area -->
                                    <Border Grid.Column="0"
                                            x:Name="MouseVisualCard"
                                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{ThemeResource ControlCornerRadius}"
                                            VerticalAlignment="Stretch"
                                            MinHeight="380"
                                            PointerWheelChanged="MouseVisualCard_PointerWheelChanged">
                                        <Grid Width="220" Height="260" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <!-- Mouse Base Silhouette Body -->
                                            <Border Width="160" Height="210"
                                                    CornerRadius="64,64,74,74"
                                                    Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1.5"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center" />
                                            <!-- Top Left Button (Left Click) -->
                                            <Border x:Name="MouseLeftBtnVisual"
                                                    Width="62" Height="80"
                                                    CornerRadius="54,6,4,4"
                                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    Margin="0,0,66,104"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center" />
                                            <!-- Top Right Button (Right Click) -->
                                            <Border x:Name="MouseRightBtnVisual"
                                                    Width="62" Height="80"
                                                    CornerRadius="6,54,4,4"
                                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    Margin="66,0,0,104"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center" />
                                            <!-- Scroll Wheel Visual -->
                                            <Border x:Name="MouseMiddleBtnVisual"
                                                    Width="22" Height="46"
                                                    CornerRadius="11"
                                                    Background="{ThemeResource ControlSolidFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    Margin="0,0,0,98"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="2">
                                                    <FontIcon x:Name="WheelUpArrow" Glyph="&#xE70E;" FontSize="8" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                                                    <FontIcon x:Name="WheelMiddleIcon" Glyph="&#xE700;" FontSize="9" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                                    <FontIcon x:Name="WheelDownArrow" Glyph="&#xE70D;" FontSize="8" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                            <!-- Side Button 1 (Back) - Default Collapsed -->
                                            <Border x:Name="MouseSide1BtnVisual"
                                                    Width="11" Height="30"
                                                    CornerRadius="5,0,0,5"
                                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    Margin="0,18,164,0"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Visibility="Collapsed" />
                                            <!-- Side Button 2 (Forward) - Default Collapsed -->
                                            <Border x:Name="MouseSide2BtnVisual"
                                                    Width="11" Height="30"
                                                    CornerRadius="5,0,0,5"
                                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    Margin="0,0,164,46"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Visibility="Collapsed" />
                                        </Grid>
                                    </Border>

                                    <!-- Right Column: Sensor Polling Rate (Hz) & Large Trajectory Smoothness Canvas -->
                                    <Border Grid.Column="1"
                                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{ThemeResource ControlCornerRadius}"
                                            VerticalAlignment="Stretch"
                                            MinHeight="380">
                                        <Canvas x:Name="TrajectoryCanvas"
                                                Background="Transparent"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"
                                                PointerPressed="TrajectoryCanvas_PointerPressed"
                                                PointerMoved="TrajectoryCanvas_PointerMoved"
                                                PointerReleased="TrajectoryCanvas_PointerReleased"
                                                PointerWheelChanged="TrajectoryCanvas_PointerWheelChanged" />
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
