<Page
    x:Class="lanlanlu_toolkit.Views.ResetFileTypeDefaultsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:lanlanlu_toolkit.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Required"
    Background="Transparent">

    <Page.Resources>
        <!-- Standardized Quick Filter / Chip Style for File Extensions -->
        <Style x:Key="QuickTagButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
            <Setter Property="FontFamily" Value="Cascadia Code, Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Style="{StaticResource PageScrollableGridStyle}">
            <StackPanel Spacing="24" HorizontalAlignment="Stretch">

                <!-- 0: Page Header -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                        <TextBlock x:Name="PageHeaderTitleTextBlock" x:Uid="ResetFileTypeDefaultsPage_Title" Style="{ThemeResource TitleTextBlockStyle}" />
                        <TextBlock x:Name="PageHeaderDescTextBlock" x:Uid="ResetFileTypeDefaultsPage_Desc" Style="{StaticResource PageHeaderSubtitleStyle}" />
                    </StackPanel>
                    <Button x:Name="OpenSettingsBtn"
                            Grid.Column="1"
                            Click="OpenSettingsBtn_Click"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8A7;" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock x:Uid="ResetFileTypeDefaultsPage_OpenSettingsBtn" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- 1: File or Extension Selection Section -->
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="ResetFileTypeDefaultsPage_Section_SelectExt" Style="{ThemeResource BodyStrongTextBlockStyle}" />

                    <!-- Card 1: File Selection Card -->
                    <Border x:Name="FileSelectCard" Style="{StaticResource FluentCardBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Left Icon -->
                            <Grid Width="24" Height="24" Margin="0,0,16,0" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE8A5;" FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>

                            <!-- Prompt info -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4" Margin="0,0,16,0">
                                <TextBlock x:Uid="ResetFileTypeDefaultsPage_SelectFilePrompt" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Uid="ResetFileTypeDefaultsPage_SelectFileDesc" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- Browse Action Button -->
                            <Button x:Name="SelectFileBtn" Grid.Column="2" Click="SelectFileBtn_Click" Style="{StaticResource StandardActionButtonStyle}" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xF12B;" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock x:Uid="ResetFileTypeDefaultsPage_SelectFileBtn" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Card 2: Manual Input & Quick Suggestions -->
                    <Border Style="{StaticResource FluentCardBorderStyle}">
                        <StackPanel Spacing="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Left Icon -->
                                <Grid Width="24" Height="24" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE8AC;" FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4" Margin="0,0,16,0">
                                    <TextBlock x:Uid="ResetFileTypeDefaultsPage_ManualTitle" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock x:Uid="ResetFileTypeDefaultsPage_ManualDesc" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>

                                <TextBox x:Name="ExtensionTextBox"
                                         Grid.Column="2"
                                         Width="180"
                                         x:Uid="ResetFileTypeDefaultsPage_TargetExtBox"
                                         VerticalAlignment="Center"
                                         FontFamily="Cascadia Code, Consolas"
                                         TextChanged="ExtensionTextBox_TextChanged" />
                            </Grid>

                            <Border Style="{StaticResource FluentHorizontalDividerStyle}" />

                            <!-- Quick Suggestion Tags (Scrollable on narrow viewports, Cascadia Code Chip style) -->
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled"
                                          HorizontalScrollMode="Enabled"
                                          VerticalScrollMode="Disabled">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock x:Uid="ResetFileTypeDefaultsPage_QuickTagsTitle"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,4,0" />

                                    <Button Content=".dat" Tag="dat" Click="QuickTagBtn_Click" Style="{StaticResource QuickTagButtonStyle}" />
                                    <Button Content=".bak" Tag="bak" Click="QuickTagBtn_Click" Style="{StaticResource QuickTagButtonStyle}" />
                                    <Button Content=".bin" Tag="bin" Click="QuickTagBtn_Click" Style="{StaticResource QuickTagButtonStyle}" />
                                    <Button Content=".log" Tag="log" Click="QuickTagBtn_Click" Style="{StaticResource QuickTagButtonStyle}" />
                                    <Button Content=".ini" Tag="ini" Click="QuickTagBtn_Click" Style="{StaticResource QuickTagButtonStyle}" />
                                    <Button Content=".cfg" Tag="cfg" Click="QuickTagBtn_Click" Style="{StaticResource QuickTagButtonStyle}" />
                                    <Button Content=".dump" Tag="dump" Click="QuickTagBtn_Click" Style="{StaticResource QuickTagButtonStyle}" />
                                    <Button Content=".tmp" Tag="tmp" Click="QuickTagBtn_Click" Style="{StaticResource QuickTagButtonStyle}" />
                                </StackPanel>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 2: Status & Reset Section -->
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="ResetFileTypeDefaultsPage_Section_Status" Style="{ThemeResource BodyStrongTextBlockStyle}" />

                    <!-- Empty State Placeholder Card -->
                    <Border x:Name="EmptyStatusCard" Style="{StaticResource FluentCardBorderStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE946;" FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       x:Uid="ResetFileTypeDefaultsPage_EmptyPrompt"
                                       Style="{ThemeResource BodyTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </Border>

                    <!-- Active Status & Action Card -->
                    <Border x:Name="ActiveStatusCard" Style="{StaticResource FluentCardBorderStyle}" Visibility="Collapsed">
                        <StackPanel Spacing="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Left Badge: Extension Display -->
                                <Border Width="56" Height="56"
                                        CornerRadius="8"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="TargetExtBadgeTextBlock"
                                               FontFamily="Cascadia Code, Consolas"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                </Border>

                                <!-- Middle: Detailed Status -->
                                <StackPanel Grid.Column="1" Spacing="4" Margin="16,0,16,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock x:Name="StatusHeaderTextBlock"
                                                   Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                   VerticalAlignment="Center" />
                                        <Border x:Name="StatusBadgeBorder"
                                                CornerRadius="4"
                                                Padding="8,2"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                VerticalAlignment="Center">
                                            <TextBlock x:Name="StatusBadgeTextBlock"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        </Border>
                                    </StackPanel>

                                    <TextBlock x:Name="StatusAppNameTextBlock"
                                               Style="{ThemeResource BodyTextBlockStyle}"
                                               TextWrapping="Wrap" />

                                    <TextBlock x:Name="StatusDetailTextBlock"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <!-- Right: Reset Button -->
                                <Button x:Name="ResetAssociationBtn"
                                        Grid.Column="2"
                                        Click="ResetAssociationBtn_Click"
                                        Style="{ThemeResource AccentButtonStyle}"
                                        MinWidth="160"
                                        VerticalAlignment="Center"
                                        IsEnabled="False">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xEA99;" FontSize="14" VerticalAlignment="Center" />
                                        <TextBlock x:Uid="ResetFileTypeDefaultsPage_ResetButton" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Bottom Notice Callout Box -->
                            <Border Style="{StaticResource FluentCalloutBoxStyle}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE946;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               x:Uid="ResetFileTypeDefaultsPage_ResetNotice"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 3: Explanations & Advanced Troubleshooting Expander -->
                <Expander x:Name="AdvancedExpander"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch"
                          CornerRadius="{ThemeResource OverlayCornerRadius}"
                          IsExpanded="False">
                    <Expander.Header>
                        <Grid HorizontalAlignment="Stretch" MinHeight="64" Margin="4,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="24" Height="24" Margin="0,0,16,0" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE897;" FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <TextBlock x:Uid="ResetFileTypeDefaultsPage_HelpExpander_Title" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Uid="ResetFileTypeDefaultsPage_HelpExpander_Desc" Style="{StaticResource PageHeaderSubtitleStyle}" />
                            </StackPanel>
                        </Grid>
                    </Expander.Header>
                    <Expander.Content>
                        <StackPanel Spacing="12">
                            <!-- Help Card 1 -->
                            <Border Style="{StaticResource FluentCalloutBoxStyle}">
                                <StackPanel Spacing="6">
                                    <TextBlock x:Uid="ResetFileTypeDefaultsPage_HelpQ1_Title" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock x:Uid="ResetFileTypeDefaultsPage_HelpQ1_Desc" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Help Card 2 -->
                            <Border Style="{StaticResource FluentCalloutBoxStyle}">
                                <StackPanel Spacing="6">
                                    <TextBlock x:Uid="ResetFileTypeDefaultsPage_HelpQ2_Title" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock x:Uid="ResetFileTypeDefaultsPage_HelpQ2_Desc" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Help Card 3: Regedit Navigation for Power Users -->
                            <Border Style="{StaticResource FluentCalloutBoxStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock x:Uid="ResetFileTypeDefaultsPage_HelpQ3_Title" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                        <TextBlock x:Uid="ResetFileTypeDefaultsPage_HelpQ3_Desc" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button x:Name="RegistryNavBtn"
                                            Grid.Column="1"
                                            Click="RegistryNavBtn_Click"
                                            x:Uid="ResetFileTypeDefaultsPage_OpenRegBtn"
                                            VerticalAlignment="Center"
                                            IsEnabled="False" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Expander.Content>
                </Expander>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
